# TEMPLATE FOR THE MASTER CREDENTIAL FILE — not for a repo-root .env.
#
# Copy to ~/.webzite/.env (override the location with WEBZITE_ENV_MASTER) and
# fill in. That file is the ONLY credential file anyone edits. Never put a real
# secret in this template; it is committed.
#
# Every worktree's .env — including this repo's — is GENERATED from the master by
# `scripts/env-sync.mjs`, which Orca's per-worktree setup hook (`npm install`)
# runs automatically. Do not hand-edit a worktree .env: the next sync discards it.
# Rotate a credential here, then `npm install` in the worktree that needs it.
#
# The master lives outside every repo on purpose. No clone, no `git clean -x`,
# and no worktree deletion can take it, and it cannot be committed by accident.
#
#   [shared]     every worktree gets these
#   [<client>]   only that client's worktree; overrides [shared] on a clash
#   [aliases]    worktree name -> section, for names that do not match by prefix
#
# Sections are named after the client folder under deliver/brandklout/. The
# worktree picks its section from its own directory name (what you typed into
# Orca), falling back to the branch's last path segment.
#
# See SYSTEM_RULES.md §4.2.2.

[aliases]
# Only needed when the worktree name is not a prefix of the section name, or
# when a short name matches more than one section.
# bk-ifa-dentistry = institute-for-advanced-dentistry
# bk-stone = stone-dental-implant-center

[shared]
# Browserbase — cloud Chrome used by the live QA harnesses
# (e.g. deliver/brandklout/<client>/workflows/08-qa/live-qa.mjs).
# One key is all that is needed: it resolves the project on its own.
# Get it from https://browserbase.com/settings
BROWSERBASE_API_KEY=

# Instatic — headless admin access, used by deliver/process/18-instatic-embeds
# and by any client workflow that syncs an Instatic site. The email is the same
# on every instance. The PASSWORD is per-instance, so it belongs in the client
# section, never here.
INSTATIC_EMAIL=

# Cloudflare account-level token. Per-zone tokens go in the client sections.
CLOUDFLAREAPI=

# Freepik / Magnific, BugHerd, Vimeo, Figma, Google Drive — all account-wide.
MAGNIFIC=
BUGHERD=
VIMEO=
FIGMASECRET=
GOOGLEDRIVE=
GOOGLEDRIVEOAUTH=
GOOGLEDRIVEOAUTHID=

[example-client]
# INSTATIC_BASE_URL has deliberately no default anywhere in the system: the
# shared toolkit refuses to guess which site it is talking to, because a shared
# installer that inherited one client's default would publish that client's
# plugin to another client's site. It belongs here, once per client.
INSTATIC_BASE_URL=
INSTATIC_PASSWORD=

# Host credentials, if the client has any. Prefix names that would otherwise
# collide with a Windows environment variable — USERNAME, HOSTNAME and PORT are
# all set by Windows itself, and the .env loaders only fill in variables that are
# NOT already set, so an unprefixed USERNAME silently resolves to the Windows
# login instead of the host account.
SITEGROUND_HOSTNAME=
SITEGROUND_USERNAME=
SITEGROUND_PORT=
SITEGROUND_PRIVATEKEY=
SITEGROUND_PUBLICKEY=
