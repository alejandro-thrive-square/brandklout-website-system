# Repo-root environment template. Copy to .env and fill in.
# .env is gitignored; .env.example is not. Never put a real secret in this file.

# Browserbase — cloud Chrome used by the live QA harnesses
# (e.g. deliver/brandklout/mason-park/workflows/08-qa/live-qa.mjs).
# One key is all that is needed: it resolves the project on its own.
# Get it from https://browserbase.com/settings
BROWSERBASE_API_KEY=

# Instatic — headless admin access, used by deliver/process/18-instatic-embeds
# and by any client workflow that syncs an Instatic site. There is deliberately
# no default site in the shared toolkit: a shared installer that inherited one
# client's default would publish to the wrong site.
INSTATIC_BASE_URL=
INSTATIC_EMAIL=
INSTATIC_PASSWORD=
