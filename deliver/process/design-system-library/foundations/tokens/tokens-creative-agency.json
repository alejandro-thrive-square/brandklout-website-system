    "border-subtle":  { "value": "#1A1A1A", "type": "color", "description": "Very subtle borders" },
    "success":        { "value": "#00FF87", "type": "color", "description": "Neon green — success (shared with secondary)" },
    "warning":        { "value": "#FFB800", "type": "color", "description": "Bright amber — warning states" },
    "error":          { "value": "#FF3366", "type": "color", "description": "Hot pink — error (shared with primary)" }
