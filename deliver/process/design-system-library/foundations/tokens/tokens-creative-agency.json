    "fast": { "value": "all 150ms cubic-bezier(0.33, 1, 0.68, 1)", "duration": "150ms", "easing": "cubic-bezier(0.33, 1, 0.68, 1)" },
    "base": { "value": "all 300ms cubic-bezier(0.33, 1, 0.68, 1)", "duration": "300ms", "easing": "cubic-bezier(0.33, 1, 0.68, 1)" },
    "slow": { "value": "all 700ms cubic-bezier(0.16, 1, 0.3, 1)",  "duration": "700ms", "easing": "cubic-bezier(0.16, 1, 0.3, 1)" }
