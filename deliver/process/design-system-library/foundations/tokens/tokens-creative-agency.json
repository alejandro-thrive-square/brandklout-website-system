    "md": { "value": "0 0 20px rgba(255, 51, 102, 0.15), 0 0 40px rgba(123, 97, 255, 0.05)" },
    "lg": { "value": "0 0 40px rgba(255, 51, 102, 0.2), 0 0 80px rgba(123, 97, 255, 0.1)" },
    "xl": { "value": "0 0 60px rgba(255, 51, 102, 0.25), 0 0 120px rgba(0, 255, 135, 0.1)" }
  },
