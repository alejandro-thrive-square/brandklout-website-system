    "primary-dark":   { "value": "#CC2952", "type": "color", "description": "Deeper pink for active/pressed states" },
    "secondary":      { "value": "#00FF87", "type": "color", "description": "Neon green — secondary accent, highlights" },
    "secondary-dark": { "value": "#00CC6C", "type": "color", "description": "Subdued green for text on dark bg" },
    "accent":         { "value": "#7B61FF", "type": "color", "description": "Electric purple — tertiary highlights" },
    "background":     { "value": "#0A0A0A", "type": "color", "description": "Near-black — primary canvas" },
    "background-alt": { "value": "#111111", "type": "color", "description": "Slightly lighter black — offset sections" },
    "surface":        { "value": "#161616", "type": "color", "description": "Dark gray — card and panel surfaces" },
    "surface-hover":  { "value": "#1F1F1F", "type": "color", "description": "Lighter gray — hover surfaces" },
    "text-primary":   { "value": "#FFFFFF", "type": "color", "description": "Pure white — primary text" },
    "text-secondary": { "value": "#B0B0B0", "type": "color", "description": "Light gray — secondary text" },
    "text-muted":     { "value": "#666666", "type": "color", "description": "Medium gray — muted text, captions" },
