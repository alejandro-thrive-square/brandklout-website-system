{
  "meta": {
    "name": "Modern SaaS",
    "style": "modern-saas",
    "version": "1.0",
    "description": "Clean, developer-focused aesthetic inspired by Linear, Vercel, and Stripe. Dark-mode-first with precise spacing and sharp geometry.",
    "author": "Webzite Studio"
  },
  "colors": {
    "primary":        { "value": "#6366F1", "type": "color", "description": "Indigo — primary actions, links, focus rings" },
    "primary-light":  { "value": "#818CF8", "type": "color", "description": "Lighter indigo for hover states" },
    "primary-dark":   { "value": "#4F46E5", "type": "color", "description": "Darker indigo for active/pressed states" },
    "secondary":      { "value": "#8B5CF6", "type": "color", "description": "Violet — secondary actions and accents" },
    "accent":         { "value": "#06B6D4", "type": "color", "description": "Cyan — highlights, badges, callouts" },
    "background":     { "value": "#0F172A", "type": "color", "description": "Slate 900 — primary background" },
    "background-alt": { "value": "#1E293B", "type": "color", "description": "Slate 800 — secondary/offset background" },
    "surface":        { "value": "#1E293B", "type": "color", "description": "Slate 800 — card and panel surfaces" },
    "surface-hover":  { "value": "#334155", "type": "color", "description": "Slate 700 — surface hover state" },
    "text-primary":   { "value": "#F8FAFC", "type": "color", "description": "Slate 50 — primary text on dark bg" },
    "text-secondary": { "value": "#CBD5E1", "type": "color", "description": "Slate 300 — secondary text" },
    "text-muted":     { "value": "#64748B", "type": "color", "description": "Slate 500 — muted/placeholder text" },
    "border":         { "value": "#334155", "type": "color", "description": "Slate 700 — borders and dividers" },
    "border-subtle":  { "value": "#1E293B", "type": "color", "description": "Slate 800 — subtle borders" },
    "success":        { "value": "#10B981", "type": "color", "description": "Emerald — success states" },
    "warning":        { "value": "#F59E0B", "type": "color", "description": "Amber — warning states" },
    "error":          { "value": "#EF4444", "type": "color", "description": "Red — error/destructive states" }
  },
  "typography": {
    "font-primary": {
      "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "type": "fontFamily",
      "weights": [400, 500, 600, 700]
    },
    "font-secondary": {
      "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "type": "fontFamily",
      "weights": [400, 500, 600]
    },
    "font-mono": {
      "value": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace",
      "type": "fontFamily",
      "weights": [400, 500]
    },
    "scale": {
      "xs":      { "value": "0.75rem",  "lineHeight": "1rem",   "letterSpacing": "0.01em",  "fontWeight": 400 },
      "sm":      { "value": "0.875rem", "lineHeight": "1.25rem","letterSpacing": "0.005em", "fontWeight": 400 },
      "base":    { "value": "1rem",     "lineHeight": "1.5rem", "letterSpacing": "0em",     "fontWeight": 400 },
      "lg":      { "value": "1.125rem", "lineHeight": "1.75rem","letterSpacing": "-0.005em","fontWeight": 400 },
      "xl":      { "value": "1.25rem",  "lineHeight": "1.75rem","letterSpacing": "-0.01em", "fontWeight": 500 },
      "2xl":     { "value": "1.5rem",   "lineHeight": "2rem",   "letterSpacing": "-0.015em","fontWeight": 600 },
      "3xl":     { "value": "1.875rem", "lineHeight": "2.25rem","letterSpacing": "-0.02em", "fontWeight": 600 },
      "4xl":     { "value": "2.25rem",  "lineHeight": "2.5rem", "letterSpacing": "-0.025em","fontWeight": 700 },
      "5xl":     { "value": "3rem",     "lineHeight": "3.25rem","letterSpacing": "-0.03em", "fontWeight": 700 },
      "display": { "value": "3.75rem",  "lineHeight": "4rem",   "letterSpacing": "-0.035em","fontWeight": 700 }
    }
  },
  "spacing": {
    "unit": 8,
    "scale": {
      "xs":  { "value": "0.25rem", "px": 4 },
      "sm":  { "value": "0.5rem",  "px": 8 },
      "md":  { "value": "1rem",    "px": 16 },
      "lg":  { "value": "1.5rem",  "px": 24 },
      "xl":  { "value": "2rem",    "px": 32 },
      "2xl": { "value": "3rem",    "px": 48 },
      "3xl": { "value": "4rem",    "px": 64 },
      "4xl": { "value": "6rem",    "px": 96 }
    }
  },
  "radius": {
    "sm":   { "value": "4px" },
    "md":   { "value": "8px" },
    "lg":   { "value": "12px" },
    "xl":   { "value": "16px" },
    "full": { "value": "9999px" }
  },
  "shadows": {
    "sm": { "value": "0 1px 2px 0 rgba(0, 0, 0, 0.3)" },
    "md": { "value": "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.3)" },
    "lg": { "value": "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -4px rgba(0, 0, 0, 0.4)" },
    "xl": { "value": "0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.4)" }
  },
  "transitions": {
    "fast": { "value": "all 100ms cubic-bezier(0.4, 0, 0.2, 1)", "duration": "100ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "base": { "value": "all 200ms cubic-bezier(0.4, 0, 0.2, 1)", "duration": "200ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)" },
    "slow": { "value": "all 400ms cubic-bezier(0.4, 0, 0.2, 1)", "duration": "400ms", "easing": "cubic-bezier(0.4, 0, 0.2, 1)" }
  }
}