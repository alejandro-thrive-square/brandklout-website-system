{
  "meta": {
    "name": "Minimal Portfolio",
    "style": "minimal-portfolio",
    "version": "1.0",
    "description": "Refined, content-first portfolio aesthetic. Maximum whitespace, restrained color palette, elegant serif/sans-serif pairing.",
    "author": "Webzite Studio"
  },
  "colors": {
    "primary":        { "value": "#2563EB", "type": "color", "description": "Blue — single accent for links and CTAs" },
    "primary-light":  { "value": "#3B82F6", "type": "color", "description": "Lighter blue for hover" },
    "primary-dark":   { "value": "#1D4ED8", "type": "color", "description": "Darker blue for active" },
    "secondary":      { "value": "#111111", "type": "color", "description": "True black — used as secondary emphasis" },
    "accent":         { "value": "#2563EB", "type": "color", "description": "Blue — same as primary, single-accent system" },
    "background":     { "value": "#FAFAFA", "type": "color", "description": "Near-white — primary background" },
    "background-alt": { "value": "#F5F5F5", "type": "color", "description": "Slightly warmer gray for offset sections" },
    "surface":        { "value": "#FFFFFF", "type": "color", "description": "Pure white — card surfaces" },
    "surface-hover":  { "value": "#F9FAFB", "type": "color", "description": "Very subtle hover" },
    "text-primary":   { "value": "#111111", "type": "color", "description": "Near-black — primary text" },
    "text-secondary": { "value": "#404040", "type": "color", "description": "Dark gray — secondary text" },
    "text-muted":     { "value": "#9CA3AF", "type": "color", "description": "Gray — captions, dates, meta text" },
    "border":         { "value": "#E5E5E5", "type": "color", "description": "Light gray — borders" },
    "border-subtle":  { "value": "#F0F0F0", "type": "color", "description": "Very light — subtle dividers" },
    "success":        { "value": "#16A34A", "type": "color", "description": "Green — success" },
    "warning":        { "value": "#CA8A04", "type": "color", "description": "Yellow — warning" },
    "error":          { "value": "#DC2626", "type": "color", "description": "Red — error" }
  },
  "typography": {
    "font-primary": {
      "value": "'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif",
      "type": "fontFamily",
      "weights": [400, 500, 700]
    },
    "font-secondary": {
      "value": "'DM Serif Display', Georgia, serif",
      "type": "fontFamily",
      "weights": [400]
    },
    "font-mono": {
      "value": "'DM Mono', 'Menlo', monospace",
      "type": "fontFamily",
      "weights": [400]
    },
    "scale": {
      "xs":      { "value": "0.75rem",   "lineHeight": "1rem",     "letterSpacing": "0.02em",   "fontWeight": 400 },
      "sm":      { "value": "0.875rem",  "lineHeight": "1.375rem", "letterSpacing": "0.01em",   "fontWeight": 400 },
      "base":    { "value": "1.0625rem", "lineHeight": "1.75rem",  "letterSpacing": "0em",      "fontWeight": 400 },
      "lg":      { "value": "1.1875rem", "lineHeight": "1.875rem", "letterSpacing": "-0.005em", "fontWeight": 400 },
      "xl":      { "value": "1.375rem",  "lineHeight": "2rem",     "letterSpacing": "-0.01em",  "fontWeight": 500 },
      "2xl":     { "value": "1.75rem",   "lineHeight": "2.25rem",  "letterSpacing": "-0.015em", "fontWeight": 500 },
      "3xl":     { "value": "2.25rem",   "lineHeight": "2.75rem",  "letterSpacing": "-0.02em",  "fontWeight": 400 },
      "4xl":     { "value": "3rem",      "lineHeight": "3.5rem",   "letterSpacing": "-0.025em", "fontWeight": 400 },
      "5xl":     { "value": "3.75rem",   "lineHeight": "4.25rem",  "letterSpacing": "-0.03em",  "fontWeight": 400 },
      "display": { "value": "4.5rem",    "lineHeight": "5rem",     "letterSpacing": "-0.04em",  "fontWeight": 400 }
    }
  },
  "spacing": {
    "unit": 8,
    "scale": {
      "xs":  { "value": "0.5rem",   "px": 8 },
      "sm":  { "value": "1rem",     "px": 16 },
      "md":  { "value": "1.5rem",   "px": 24 },
      "lg":  { "value": "2.5rem",   "px": 40 },
      "xl":  { "value": "4rem",     "px": 64 },
      "2xl": { "value": "6rem",     "px": 96 },
      "3xl": { "value": "10rem",    "px": 160 },
      "4xl": { "value": "14rem",    "px": 224 }
    }
  },
  "radius": {
    "sm":   { "value": "2px" },
    "md":   { "value": "4px" },
    "lg":   { "value": "6px" },
    "xl":   { "value": "8px" },
    "full": { "value": "9999px" }
  },
  "shadows": {
    "sm": { "value": "0 1px 2px rgba(0, 0, 0, 0.04)" },
    "md": { "value": "0 2px 8px rgba(0, 0, 0, 0.06)" },
    "lg": { "value": "0 4px 16px rgba(0, 0, 0, 0.08)" },
    "xl": { "value": "0 8px 32px rgba(0, 0, 0, 0.1)" }
  },
  "transitions": {
    "fast": { "value": "all 150ms ease",          "duration": "150ms", "easing": "ease" },
    "base": { "value": "all 300ms ease",          "duration": "300ms", "easing": "ease" },
    "slow": { "value": "all 600ms ease-in-out",   "duration": "600ms", "easing": "ease-in-out" }
  }
}