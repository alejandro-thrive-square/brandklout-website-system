                }
              },
              {
                "type": "Paragraph",
                "set_style": {
                  "style_names": [
                    "reveal"
                  ]
                },
                "set_text": {
                  "text": "Real estate runs in my family. Underwriting runs in how I work."
                }
              }
            ]
          }
        ]
      },
      {
        "type": "DivBlock",
        "set_style": {
          "style_names": [
