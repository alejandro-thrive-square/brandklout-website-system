        }
      ]
    },
    "lenders": {
      "kind": "each",
      "from": "$financing:partners.items",
      "match": "^(.+)$",
      "node": {
        "@type": "LoanOrCredit",
        "@id": "/financing#{1|slug}",
        "name": "{1} patient financing",
        "description": "$.text[0]",
        "provider": {
          "@type": "Organization",
          "name": "{1}"
        },
        "areaServed": {
          "@type": "Country",
          "name": "United States"
        }
      }
    },
    "proceedTerms": {
      "amount": {
        "@type": "MonetaryAmount",
        "maxValue": 60000,
        "currency": "USD"
      },
      "loanTerm": {
        "@type": "QuantitativeValue",
        "maxValue": 96,
        "unitCode": "MON"
      },
      "requiredCollateral": "None"
    }
