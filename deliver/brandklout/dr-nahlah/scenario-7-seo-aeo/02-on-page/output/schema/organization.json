        {
          "@type": "LocationFeatureSpecification",
          "name": "Intraoral scanner",
          "value": true,
          "description": "Digital impressions. No tray, no putty, no gagging, and an accuracy a physical impression cannot reach."
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Guided implant surgery",
          "value": true,
          "description": "Every implant is planned on the scan and placed through a printed guide, at the planned angle and depth. Smaller incisions, shorter recovery."
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "In-house digital lab",
          "value": true,
          "description": "Both practices have one. A shade or a shape can be argued about in person instead of described on a form."
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Milling machine",
          "value": true,
          "description": "The design is cut here. Nothing is posted to another state and waited on, which is what removes weeks from a full-arch case."
        },
        {
          "@type": "LocationFeatureSpecification",
