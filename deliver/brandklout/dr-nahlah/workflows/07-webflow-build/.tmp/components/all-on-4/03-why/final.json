c7-48b4-a9f8-aa428e48dfc9","52d0e6a1-01ca-43e9-a696-42eb6e85a3d4","268f59cf-37a8-41e4-9661-0bac48c38ff6"],"data":{"devlink":{"runtimeProps":{},"slot":""},"displayName":"","attr":{"id":""},"xattr":[],"search":{"exclude":false},"visibility":{"conditions":[],"keepInHtml":{"tag":"False","val":{}}}}},{"_id":"de599541-3bc7-48b4-a9f8-aa428e48dfc9","text":true,"v":"A failing arch usually comes with bone loss, and the traditional answer was to graft for a year before anyone could place anything. All-on-4 works the other way round: the two rear implants are "},{"_id":"52d0e6a1-01ca-43e9-a696-42eb6e85a3d4","type":"Block","tag":"strong","classes":["4f0f843e-27b2-4b62-9cb0-9a348f17eda0"],"children":["62ffb552-4739-4826-b301-f8dfe70a0351"],"data":{"devlink":{"runtimeProps":{},"slot":""},"displayName":"","attr":{"id":""},"xattr":[],"search":{"exclude":false},"visibility":{"conditions":[],"keepInHtml":{"tag":"False","val":{}}},"text":true,"tag":"strong"}},{"_id":"62ffb552-4739-4826-b301-f8dfe70a0351","text":true,"v":"angled forward"},{"_id":"268f59cf-37a8-41e4-9661-0bac48c38ff6","text":true,"v":" into the denser bone at the front of the jaw, so four posts can carry a full arch without rebuilding the back of the mouth first."},{"_id":"aa93085c-de10-4947-a111-4a16ff631949","type":"Paragraph","tag":"p","classes":["660ac244-d00f-4d20-a2b3-da3f50a6fb94"],"children":["741d4a79-1369-40a4-94b7-7fea37a955ec"],"data":{"devlink":{"runtimeProps":{},"slot":""},"displayName":"","attr":{"id":""},"xattr":[],"search":{"exclude":false},"visibility":{"conditions":[],"keepInHtml":{"tag":"False","val":{}}}}},{"_id":"741d4a79-1369-40a4-94b7-7fea37a955ec","text":true,"v":"That is why it is more cost-effective than replacing every tooth with its own implant, and why patients with a failing dentition or severe bone loss are often still candidates."},{"_id":"d89ffba5-789a-43e9-90c8-18cdbf9a9113","type":"Paragraph","tag":"p","classes":["660ac244-d00f-4d20-a2b3-da3f50a6fb94"],"children":["e9d5bd5f-da32-45ec-b