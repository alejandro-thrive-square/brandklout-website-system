      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Our Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Dental Implants",
              "description": "Dental implants offer the same look and functionality of natural teeth, so you can brush and floss like normal, plus eat all of the foods you love with little to no pain or discomfort! Unlike dentures, dental implants are a permanent solution to missing teeth. Give our office a call today and speak with Dr. Esam Nahlah and his professional dental team about your dental implant candidacy.",
              "sameAs": "https://drnahlah.com/dental-implants/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "All-on-4 Dental Implants",
              "description": "For patients who are missing some or all of their teeth, All-on-4 dental implants offer a permanent, lasting solution that perfectly replicate the look and feel of your natural teeth. While traditional (single) implants attach one tooth to one implant, All-on-4 implants fully reconstruct a patient’s upper and lower arch, using just four titanium implant posts.",
              "sameAs": "https://drnahlah.com/all-on-4/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Cosmetic Dentistry",
              "description": "You can upgrade your smile with personalized cosmetic dentistry in McLean, VA! Through personalized treatments, including porcelain veneers, dental crowns, and teeth whitening, we can help you find confidence in your smile once again. Our cosmetic dentist is skilled in the artistry and functional aspects of cosmetic dentistry treatment.",
              "sameAs": "https://drnahlah.com/cosmetic-dentistry/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Porcelain Veneers",
              "description": "o help you regain confidence in your smile and yourself, we offer porcelain veneers in McLean, VA, a cosmetic dentistry treatment that hides tooth imperfections such as chips, gaps, discoloration, or crookedness. Our cosmetic dentist at Dental Group of Tysons is experienced in the artistic and technical aspects of these custom smile makeovers and can create your dream smile in as few as two appointments with porcelain veneers!",
              "sameAs": "https://drnahlah.com/veneers/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Dental Crowns & Bridges",
              "description": "If you’ve got chipped teeth, cracked teeth, or broken teeth, we can make your smile whole and fully functional again with dental bridges and dental crowns in McLean, VA. At Dental Group of Tysons our dentist and dental team are skilled in these restorative treatments and have the artistic eye to provide aesthetically attractive outcomes, as well as returning function to your tooth.",
              "sameAs": "https://drnahlah.com/dental-crowns-and-bridges/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Smile Makeover",
              "description": "At Dental Group of Tysons in McLean, VA, this is exactly what Dr. Esam Nahlah and his elite team of professionals brings to the table. Our team offers complete Smile Makeover treatments that can transform even the worst set of teeth into something that is truly stunning.",
              "sameAs": "https://drnahlah.com/smile-makeover/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Teeth Whitening",
              "description": "Your best solution to brighten your teeth, and have the results last long-term, is professional teeth whitening from a qualified cosmetic dentist! Our team at Dental Group of Tysons offers affordable, office-based teeth whitening in McLean, VA with professional-grade bleaching agents that can brighten your teeth multiple shades lighter in just one visit to our office.",
              "sameAs": "https://drnahlah.com/teeth-whitening/"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
