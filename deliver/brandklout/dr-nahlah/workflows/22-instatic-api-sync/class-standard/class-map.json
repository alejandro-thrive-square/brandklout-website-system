  "merge": {},
  "notes": {
    "folders": "empty on purpose: this site's prefixes are written with a dash (pk-card, lp-hero), and `folders` only expands folder_element names (one underscore), so every class is an explicit rename.",
    "wrap": "max-width + auto margins + the gutter padding + the chapter-rail offset on the left; this site has no container-large, so it takes the library name. It carries padding-global's job too: splitting it into padding-global + container-large is a later, visual change, not a rename.",
    "no-rail": "only ever stacked on wrap: drops the chapter-rail left offset (nav bars). Combo.",
    "section": "paddingBlock: var(--section) on the same div as wrap: the section's vertical padding.",
    "label": "small uppercase accent label (229 of 259 uses sit inside chapter-tag): the tagline role.",
    "chapter-tag": "the flex row that holds the decorative line (<i>) and the tagline span above section headings ('Chapter 01 · The Reality').",
    "btn-primary / btn-ghost / btn-dark": "every btn carries one of the first two; gold gradient fill = is-primary, outlined = is-secondary; btn-dark (dark fill) is unused today.",
    "magnetic": "no styles: the hook site.js uses for the magnetic hover on buttons. Named as a state combo; moving it to a data- attribute is the standard's next step.",
    "pk": "'page kit' section wrapper (background + body colour) on 266 sections; pk-alt / pk-light only set the background in `.pk.pk-alt` / `.pk.pk-light`, hence combos.",
    "pk-cta": "the gold gradient call-to-action band near the bottom of 22 pages (stacked on pk); cta-in / cta-offices / cta-phones are its inside.",
    "pk-lede / lc-head / lc-body": "two-column intro block: heading column + body column.",
    "pk-next / nx-k / nx-t / nx-d": "the 'next pages' link grid: small kicker, page title, one-line description per link.",
    "pk-readon": "small uppercase 'read on' link inside cards and FAQ answers; pk-readon-block puts it (or pk-more) on its own line.",
    "pk-card-fig-pad / mz-plain": "image shown with object-fit: contain on a tinted pad (logos, diagrams).",
    "sp-fig-top / mband-top": "both only set object-position 50% 0% on the image inside; two names because they are separate classes today. Merge candidate.",
    "pk-split-rev / st-row-rev": "both move the media column to the right from 900px. Merge candidate.",
    "dr-": "dr- here is the menu DRAWER (dr-grid, dr-col, dr-foot), not 'doctor'.",
    "pg-hero + lp-hero / lp-hero-form / lp-ty-hero / bl-ph": "every page hero is pg-hero; the others are always stacked on it and only change its padding/height, so they become is- combos (landing, landing with form, thank-you, blog article).",
    "lp-": "lp- = the ads landing pages (/ads-landing-pages/*). Components there: landing-header, landing-hero, landing-steps, landing-tiers (FP1/FP2/FP3 or price tiers), landing-faq, landing-final, landing-journey, landing-footer; loose single elements go to landing_.",
    "lp-nav / lp-foot": "always stacked on nav / foot on the landing pages: combos.",
    "lp-rail": "the fixed call/book bar at the bottom of the screen on landing pages.",
    "lp-film": "the film card inside the landing final section (lp-final-grid).",
    "ta": "the FP1 / FP2 / FP3 comparison of full-arch types (index and all-on-4); ta-fp1..3 become is-type-1..3 because a letter+digit segment fails the classifier and 'fp' is an abbreviation.",
    "ch-": "the home page chapters (Arrival, Reality, Difference, Specialist, Transformation, Path, Standard, Proof, Invitation, Services) become section_<chapter>; their prefixes (ar, re, df, vs, doc, tf, pa, std, sv, pf, iv) become the chapter's folder.",
    "vs-": "the 'Here vs Elsewhere' comparison table in the Difference chapter; vs-us / vs-them are the two columns.",
    "vimeo-deskop": "sic: the old name is misspelled; the pair shows one embed on desktop and the other from the tablet breakpoint down.",
    "ft-a..d": "position modifiers of the four facility photos (grid spans), stacked on ft-fig.",
    "wt-us": "the highlighted 'in-office, here' column of the whitening comparison table.",
    "cr-key": "the 01, 02 … numbers in the credentials lists on /meet-dr-nahlah.",
    "bl-toc / bl-faq / sv-follow": "not in the registry as classes: site.js creates these elements at run time (`nav.className = 'bl-toc'`, `faq.className = 'bl-faq'`, `el.className = 'sv-follow'`); the rename rewrites those class contexts.",
    "LEFT OUT": "bl-when (the date line inside the 43 Journal posts: it lives in the posts CMS table, which class-rename does not rewrite; rename it only together with the post bodies), wz-* and pin-spacer (runtime classes from the Webzite kit and GSAP ScrollTrigger), lc_reviews_widget (third-party widget), flex-test (an empty, unused test rule: delete it rather than rename), and selectors that match nothing on the site (head, more, lp-warn, st-plate, pl-mark, pl-label, ga-empty, ct-office-flag: delete-candidates).",
    "MERGE CANDIDATES (audit, identical declarations; not merged here)": "ch-proof = ch-invitation = bl-rc-dark; ch-reality = ch-services; std-grid = pk-cards; ft-fig = st-fig; doc-creds = lp-films; lp-cta-aside = lp-sec-aside. Also sp-fig-top = mband-top and pk-split-rev = st-row-rev by behaviour.",
    "ga-item": "the audit says it reimplements `hide` (display:none base): the gallery script shows the items. Kept as a custom class: the filter hides/shows by [hidden]."
  }
}