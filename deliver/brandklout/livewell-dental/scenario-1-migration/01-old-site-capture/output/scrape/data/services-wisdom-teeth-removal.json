          "mainEntity": [
            {
              "@type": "Question",
              "name": "Do all wisdom teeth need to be removed?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Some wisdom teeth can stay if they are healthy, fully erupted, easy to clean, and not causing problems. We recommend removal when they are painful, impacted, infected, or likely to harm nearby teeth."
              }
            },
            {
              "@type": "Question",
              "name": "What does impacted wisdom tooth mean?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "An impacted wisdom tooth is trapped under the gums or bone, or angled in a way that prevents it from coming in properly."
              }
            },
            {
              "@type": "Question",
              "name": "When is the best age to remove wisdom teeth?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Many people are evaluated in their teens or early twenties because the roots may be easier to manage before they fully develop. Adults can still have wisdom teeth removed when needed."
              }
            },
            {
              "@type": "Question",
              "name": "Does wisdom teeth removal hurt?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The area is numbed during treatment, and we focus on keeping you comfortable. Soreness, swelling, and jaw stiffness are common afterward, but they usually improve as healing progresses."
              }
            },
            {
              "@type": "Question",
              "name": "How long does recovery take?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Most patients feel significantly better within a few days, though full healing takes longer. We will give you instructions for food, cleaning, swelling, and activity."
              }
            }
          ]
