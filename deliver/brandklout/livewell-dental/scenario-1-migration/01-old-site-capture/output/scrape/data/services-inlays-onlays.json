          },
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How long can inlays or onlays last?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Inlays and onlays can last for years with proper care. Their lifespan depends on the material, bite forces, oral hygiene, grinding habits, and regular dental maintenance."
              }
            },
            {
              "@type": "Question",
              "name": "What is the difference between an inlay and an onlay?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "An inlay repairs the inner chewing surface of a tooth. An onlay covers a larger area and may protect one or more weakened cusps. Both are custom restorations used when a regular filling may not be enough."
              }
            },
            {
              "@type": "Question",
              "name": "Are inlays and onlays better than fillings?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "They can be better when the damaged area is too large for a standard filling to support well. A small cavity may still only need a filling, but a wider or weaker area may need a custom restoration."
              }
            },
            {
              "@type": "Question",
              "name": "Do inlays and onlays hurt?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Treatment is done with local anesthesia, so you should not feel pain while the tooth is being prepared. Mild soreness or temperature sensitivity can happen afterward while the tooth adjusts."
