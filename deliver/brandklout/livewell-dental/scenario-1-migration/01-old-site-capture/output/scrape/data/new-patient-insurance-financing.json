              "@type": "Question",
              "name": "Do you accept dental insurance?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. We accept most dental insurance plans and can help verify your benefits before treatment."
              }
            },
            {
              "@type": "Question",
              "name": "Will you check my insurance benefits for me?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Our team can review your coverage, estimate your benefits, and explain what your plan may contribute."
              }
            },
            {
              "@type": "Question",
              "name": "Will I know the cost before treatment begins?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. We believe in clear pricing, so you will receive a treatment estimate before moving forward."
              }
            },
            {
              "@type": "Question",
              "name": "Do you offer payment plans?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. We offer flexible financing options, including in-house payment plans and third-party financing when available."
              }
            },
            {
              "@type": "Question",
              "name": "What financing options do you work with?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Livewell Dental works with options such as Cherry Financing, Alphaeon Credit, and One Patient at a Time."
              }
            },
            {
              "@type": "Question",
              "name": "Do you have options for patients without insurance?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. The Livewell Membership is designed for patients without dental insurance or those who prefer a simpler alternative."
              }
            },
            {
              "@type": "Question",
              "name": "Can I use financing for cosmetic or implant treatment?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Financing may be used for many cosmetic, restorative, and implant treatments, depending on approval and the treatment plan."
              }
            },
