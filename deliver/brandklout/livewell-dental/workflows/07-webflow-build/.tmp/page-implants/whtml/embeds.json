   "script": false,
   "v": "<style>*{margin:0;padding:0;box-sizing:border-box}video{max-width:100%;display:block}.imp-hero-media video{width:100%;aspect-ratio:16/9;object-fit:cover;background:#071e2d}</style><video controls=\"\" poster=\"https://cdn.prod.website-files.com/69d03fdbe999e9907724a69d/69d446266d265c2a16c702a7_dr%20kim%20with%20a%20patient.webp\" preload=\"none\">\n<source src=\"https://cdn.prod.website-files.com/69d03fdbe999e9907724a69d/6a0cbb4e6f9c99a180fe227d_ck-dr._kim_implant_patient_vision_v1%20%28720p%29_mp4.mp4\" type=\"video/mp4\"/>\n</video>"
  },
  {
   "slot": 1,
   "classes": [
    "imp-hero-copy"
   ],
   "script": false,
   "v": "<style>*{margin:0;padding:0;box-sizing:border-box}.imp-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;letter-spacing:.08em;text-transform:uppercase;padding:17px 30px;border-radius:999px;text-decoration:none;border:0;cursor:pointer;transition:transform .12s ease,box-shadow .12s ease,background .12s ease}.imp-btn:focus-visible{outline:3px solid #d3aa5a;outline-offset:2px}.imp-btn-primary{background:#0b2c41;color:#fff;box-shadow:0 8px 22px rgba(11,44,65,.28)}.imp-btn-primary:hover{transform:translateY(-1px);background:#071e2d}.imp-field{margin-bottom:14px}.imp-field label{display:block;font-size:12.5px;font-weight:600;margin-bottom:6px;letter-spacing:.02em}.imp-field input{width:100%;padding:13px 14px;border:1.5px solid #d8e0e4;border-radius:10px;font:inherit;font-size:15px;background:#fff}.imp-field select{width:100%;padding:13px 14px;border:1.5px solid #d8e0e4;border-radius:10px;font:inherit;font-size:15px;background:#fff}.imp-field input:focus{outline:none;border-color:#0b2c41;box-shadow:0 0 0 3px rgba(11,44,65,.14)}.imp-field select:focus{outline:none;border-color:#0b2c41;box-shadow:0 0 0 3px rgba(11,44,65,.14)}.imp-form-card .imp-btn{width:100%}.imp-privacy{font-size:12px;color:#83919b;margin-top:12px;text-align:center}</style><form id=\"lead-form\" novalidate=\"\">\n<div class=\"imp-field\">\n<label for=\"f-name\">Full name</label>\n<input autocomplete=\"name\" id=\"f-name\" name=\"name\" placeholder=\"Jane Smith\" required=\"\" type=\"text\"/>\n</div>\n<div class=\"imp-field\">\n<label for=\"f-phone\">Phone</label>\n<input autocomplete=\"tel\" id=\"f-phone\" name=\"phone\" placeholder=\"(703) 555-0123\" required=\"\" type=\"tel\"/>\n</div>\n<div class=\"imp-field\">\n<label for=\"f-email\">Email</label>\n<input autocomplete=\"email\" id=\"f-email\" name=\"email\" placeholder=\"you@email.com\" type=\"email\"/>\n</div>\n<div class=\"imp-field\">\n<label for=\"f-need\">What describes you best?</label>\n<select id=\"f-need\" name=\"situation\">\n<option>I'm missing one tooth</option>\n<option>I'm missing several teeth</option>\n<option>I wear a denture or partial that doesn't fit right</option>\n<option>I may need most or all teeth replaced</option>\n<option>Not sure — I want a professional opinion</option>\n</select>\n</div>\n<button class=\"imp-btn imp-btn-primary\" type=\"submit\">Get My Consultation</button>\n<p class=\"imp-privacy\">Your information is private and only used to contact you about scheduling. No spam, ever.</p>\n</form>"
  },
