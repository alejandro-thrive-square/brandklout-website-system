  "merge": {},
  "notes": {
    "_site": "Institute for Advanced Dentistry, local house build (site-src) before launch. Every old name is listed explicitly (no folders): --files mode reads rename only.",
    "_uniqueness": "Every new name is unique. The CSS writes modifiers bare (.row--flip, not .row.row--flip), so two old modifiers sharing one combo name would leak styles onto each other. Unify combos (one is-flip) only after the selectors are compounded by hand.",
    "d1": "display sizes on h1 (d1), h2 (d2), h3 (d3); d4 sits mostly on h3 that look like a fourth level: the heading-style-h# roles",
    "d1--sm": "only the invitation h2 (57/57, always with d1): a custom class for unique text on top of heading-style-h1",
    "lede": "not type-only (max-width 34rem, colour) so not text-size-medium: a site utility in the text-style family",
    "lede--ink": "colour only (--on-light-dim), always stacked on lede: a text-color utility",
    "spec": "mono uppercase small text on p/span/figcaption (666 uses): type-only, a site utility",
    "wrap": "container-large is not used on this site; it also carries padding-inline (Client-First would split padding-global + container-large)",
    "pad": "9rem block padding on sections: padding-section-large; pad--tight (6rem, never stacked on pad) is padding-section-medium; pad--top is CSS-only (unused in markup)",
    "g-white": "grounds (KIT.md: g-bone, g-paper, g-sand, g-white, g-mist) are background-colour utilities",
    "nav__logo--dark": "display:none and nothing ever shows it (no other rule): it is the hide utility; a custom name would still be flagged \"reimplements hide\"",
    "care-fig--product": "aspect-ratio 16/9 = the library aspect-ratio-widescreen; its context rule (.care-fig--product img { height:100% }) follows the rename",
    "ab-sr": "the standard sr-only declarations: hide-visually",
    "prose": "long copy whose children are styled by context: text-rich-text is the one class allowed to do that (CLASS-STANDARD 5)",
    "btn": "library button with library combos: gold = is-primary, line = is-secondary, ink = is-alternate, sm = is-small; is-gold stays on the call bar link (already a combo, in bounds)",
    "link": "arrow text link (inline-flex + svg), not a button: a custom component",
    "ch": "every chapter section carries it (300 uses): section_chapter, with chapter_* for its shared scaffolding; home chapters get section_<beat>",
    "hero": "the kit hero section: section_hero with is-plain / is-split / is-wide / is-index",
    "ask": "the consultation form: the form_ folder of the library; ask--live is made by push/prepare.mjs (not in site-src)",
    "no-motion": "added to <html> by js/00-core.js when motion is off; a state, so a combo name",
    "ln": "SplitText linesClass (and its generated \"-mask\" class) / wordsClass: set by string options the engine does not rewrite; see README hand edits",
    "row--flip": "flip variants are named by what comes first, uniquely per base: row is-text-first, pull is-quote-first, signs is-list-first, case is-photo-first, cosmetic hero is-hero-photo-first",
    "say": "KIT \"Say: one key idea\": idea_*",
    "signs": "KIT \"Signs: candidacy, symptoms, comfort\" with drawn tick marks: checklist_*",
    "pull": "KIT \"Pull: a patient's words\": quote_*",
    "line": "KIT \"Line: visits, process\": timeline_*",
    "figs": "KIT \"Figs: numbers from facts.md\": stats_*",
    "more": "KIT \"More: related pages\": related_*",
    "fold": "<details> fold-away copy: disclosure_*",
    "vs": "the comparison table",
    "voices": "CSS-only today (20-kit.css, js/00-core.js finds it by [data-voices]); renamed so the kit stays in one standard",
    "g": "svg <g>/<path>/<line> inside the home compare drawing; g--soft is read by js/10-home.js classList.contains",
    "cos-ch": "group scope classes become combos named for the group (cos = cosmetic, ab = about, arch = full arch, care, jr = journal)",
    "elfsight-app-7febe92d-b5da-447f-b53f-9593eec9da53": "NOT renamed: Elfsight needs this exact class (data/embeds.json). It stays the one out-of-bounds name in the local audit",
    "tag": "NOT renamed: tag is a library name (in bounds) and scripts read it"
  }
}
