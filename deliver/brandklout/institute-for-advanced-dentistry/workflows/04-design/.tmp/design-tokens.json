    },
    "accent": {
      "family": "Instrument Serif",
      "styles": [
        "italic 400",
        "400"
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ]
    },
    "hosting": "self-hosted woff2, prototypes/home/fonts/"
  },
  "type": {
    "unit": "rem x multiplier; multipliers step at the px breakpoints, never clamp()",
    "d1": {
      "rem": 6,
      "lineHeight": 0.98,
      "tracking": "-0.028em"
    },
    "d1-sm": {
      "rem": 5
