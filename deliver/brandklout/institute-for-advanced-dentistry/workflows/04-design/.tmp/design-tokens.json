    "d2": {
      "rem": 4,
      "lineHeight": 1.02
    },
    "d3": {
      "rem": 2.25,
      "lineHeight": 1.08
    },
    "d4": {
      "rem": 1.5,
      "weight": 400
    },
    "statement": {
      "rem": 3,
      "lineHeight": 1.2
    },
    "lede": {
      "rem": 1.25
    },
    "body": {
      "rem": 1.0625,
      "lineHeight": 1.6
    },
    "spec": {
      "rem": 0.78,
      "tracking": "0.14em",
      "transform": "uppercase",
      "family": "mono"
    },
    "multipliers": {
      "base": {
        "d1": 1,
        "d2": 1,
        "d3": 1,
        "statement": 1,
        "text": 1,
        "spec": 1
      },
      "1279": {
        "d1": 0.84,
        "d2": 0.86,
        "statement": 0.88
      },
      "991": {
        "d1": 0.7,
        "d2": 0.76,
        "d3": 0.9,
        "statement": 0.78
      },
      "767": {
        "d1": 0.54,
        "d2": 0.62,
        "d3": 0.82,
        "statement": 0.62
      },
      "479": {
        "d1": 0.53,
        "d2": 0.64,
        "d3": 0.9,
        "statement": 0.66,
        "text": 1.2,
        "spec": 1.22
      }
    }
  },
  "space": {
    "gutter": {
      "base": "4rem",
      "1279": "3rem",
      "991": "2.25rem",
      "767": "1.5rem"
    },
    "navHeight": {
      "base": "5rem",
      "767": "4.25rem"
    },
    "chapterPadTop": "9rem",
    "contentMax": "96rem"
  },
  "radius": {
    "button": "0.2rem",
    "field": "0.3rem",
    "media": "0.6rem-0.8rem",
    "chip": "2rem"
  },
  "breakpoints": [
    1279,
    991,
    767,
    479
  ],
  "motion": {
    "ease": "cubic-bezier(.22,.8,.2,1)",
    "gsapDefault": "expo.out / 1.1s",
    "smoother": {
      "smooth": 1.1,
      "where": "hover+fine pointer and width > 991"
    },
    "pins": [
      "arrival +115%",
      "question +240%",
      "design +300%",
      "path = rail travel"
    ]
  }
}