      "graphite": {
        "value": "#373435",
        "note": "Pantone 447 C"
      },
      "steel": {
        "value": "#727376",
        "note": "Pantone Cool Gray 10 C"
      },
      "silver": {
        "value": "#bdbfc1",
        "note": "Pantone 442 C; hairlines at 14-22% alpha"
      }
