   "href": "/services/invisalign/",
   "section": 5
  },
  {
   "type": "heading",
   "level": 4,
   "text": "INVISALIGN SPECIAL OFFER: $1000 OFF",
   "section": 6
  },
  {
   "type": "para",
   "text": "Regular Price: $4800",
   "html": "<p>Regular Price: $4800</p>",
   "section": 6
  },
  {
   "type": "para",
   "text": "Special Price: $3800",
   "html": "<p>Special Price: $3800</p>",
   "section": 6
  },
  {
   "type": "para",
   "text": "Prepay in full to receive a 5% discount and insurance payments would be reimbursed back to the patient. In-office and third-party payment plans are available.",
   "html": "<p>Prepay in full to receive a 5% discount and insurance payments would be reimbursed back to the patient. In-office and third-party payment plans are available.</p>",
   "section": 6
  },
  {
   "type": "heading",
   "level": 4,
   "text": "FREE SECOND OPINION",
   "section": 7
  },
  {
   "type": "para",
   "text": "Are you confused about a treatment plan, or skeptical about a doctor’s opinion? At Mason Park Dental, educating our patients is a top priority. See a doctor you can trust with a free second opinion consultation.",
   "html": "<p>Are you confused about a treatment plan, or skeptical about a doctor’s opinion? At Mason Park Dental, educating our patients is a top priority. See a doctor you can trust with a free second opinion consultation.</p>",
   "section": 7
  },
