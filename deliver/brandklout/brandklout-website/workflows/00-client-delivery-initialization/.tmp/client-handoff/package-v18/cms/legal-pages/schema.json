{
  "collection_name": "Legal Pages",
  "recommended_collection_slug": "legal",
  "description": "Editable policy / legal / compliance pages. Add a new item to create another page from the same CMS template.",
  "fields": [
    {
      "name": "Name",
      "key": "name",
      "type": "plain_text",
      "required": true,
      "help": "Internal CMS item name."
    },
    {
      "name": "Slug",
      "key": "slug",
      "type": "slug",
      "required": true,
      "help": "Example: privacy or accessibility."
    },
    {
      "name": "Footer label",
      "key": "footer_label",
      "type": "plain_text",
      "required": true,
      "help": "Short label for footer/navigation links."
    },
    {
      "name": "Eyebrow",
      "key": "eyebrow",
      "type": "plain_text",
      "required": false
    },
    {
      "name": "Page title",
      "key": "title",
      "type": "plain_text",
      "required": true
    },
    {
      "name": "Intro",
      "key": "intro",
      "type": "plain_text",
      "required": false
    },
    {
      "name": "Notice",
      "key": "notice",
      "type": "plain_text",
      "required": false,
      "help": "Optional callout shown above the rich-text body."
    },
    {
      "name": "Body",
      "key": "body_richtext",
      "type": "rich_text",
      "required": true,
      "help": "Main editable CMS content. Use H2s, paragraphs, links and lists."
    },
    {
      "name": "SEO title",
      "key": "seo_title",
      "type": "plain_text",
      "required": true
    },
    {
      "name": "SEO description",
      "key": "seo_description",
      "type": "plain_text",
      "required": true
    },
    {
      "name": "Canonical path",
      "key": "canonical_path",
      "type": "plain_text",
      "required": false
    },
    {
      "name": "Sort order",
      "key": "sort_order",
      "type": "number",
      "required": false
    },
    {
      "name": "Published",
      "key": "published",
      "type": "boolean",
      "required": true,
      "default": true
    },
    {
      "name": "Show market prequalification",
      "key": "show_market_prequalification",
      "type": "boolean",
      "required": false,
      "default": true
    }
  ],
  "template": "cms-templates/legal-page-template.html",
  "stylesheet": "assets/pages/legal-cms-template.css",
  "recommended_route": "/legal/{slug}"
}