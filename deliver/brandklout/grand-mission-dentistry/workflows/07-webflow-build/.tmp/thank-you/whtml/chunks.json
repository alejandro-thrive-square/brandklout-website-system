[
 {
  "key": "c0",
  "parent": null,
  "html": "<div class=\"ty-page\"><header class=\"gm-header\" id=\"header\"><div class=\"gm-box shell header__inner\"><a class=\"header__logo\" href=\"#arrival\" aria-label=\"Grand Mission Dentistry\"><img class=\"logo-light\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7cee705fbdbf789cecc_logo-light.webp\" alt=\"Grand Mission Dentistry\" width=\"auto\" height=\"auto\" loading=\"eager\"><img class=\"logo-dark\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7cd42ae23ca5e859fdb_logo-dark.webp\" alt=\"Grand Mission Dentistry\" width=\"auto\" height=\"auto\" loading=\"eager\"></a><div class=\"header__chapter\" id=\"chapterReadout\" aria-hidden=\"true\"><b class=\"ty-b\" id=\"chNum\">00</b><span class=\"gm-box\" id=\"chName\">Arrival</span><i class=\"ty-i\" id=\"chBar\"></i></div><div class=\"header__actions\"><a class=\"header__phone\" href=\"#\" data-tel-link=\"\"><svg class=\"ty-emb-1 ty-svg\" aria-hidden=\"true\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n<path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1.1 1A16 16 0 0 1 4 5.1 1 1 0 0 1 5 4Z\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"2\"></path>\n</svg><span class=\"header__phone-text\"><small class=\"ty-emb-2 ty-small\">Call the practice</small> <strong class=\"ty-strong\" data-tel=\"\">(281) 789-8836</strong></span></a> <a class=\"ty-a btn magnetic\" href=\"#fast-track\"><span class=\"btn-before\"></span><span class=\"ty-span\">Call now</span></a></div></div><div class=\"header__progress\" id=\"readProgress\"></div></header><div class=\"ty-div-2\" id=\"smooth-wrapper\"><div class=\"gm-box\" id=\"smooth-content\"><main class=\"gm-box\" id=\"top\"><section class=\"gm-box ch ty-ch-arrival\" id=\"arrival\" data-chapter=\"0\" data-chapter-name=\"Arrival\"><div class=\"arrival__media\"><img class=\"ty-img\" id=\"arrivalImg\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/69b2b3fadc35de3b8a991be4_imgi_57_GrandMissionDentistry-115-2048x1362.webp\" width=\"auto\" height=\"auto\" loading=\"eager\" aria-hidden=\"true\"><div class=\"arrival__media-after\"></div></div><div class=\"arrival__aurora\" aria-hidden=\"true\"></div><div class=\"arrival__veil\" id=\"arrivalVeil\" aria-hidden=\"true\"></div><div class=\"gm-box shell status\" id=\"arrivalInner\"><div class=\"stamp\" id=\"stamp\" aria-hidden=\"true\"><span class=\"stamp__ripple\" id=\"stampRipple\"></span> <span class=\"stamp__ring\" id=\"stampRing\"></span><svg class=\"stamp__check ty-emb-1 ty-emb-3 stamp__check\" fill=\"none\" viewbox=\"0 0 48 48\">\n<path d=\"M13 25.5 20.5 33 35.5 16\" id=\"stampPath\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"4\"></path>\n</svg></div><p class=\"ty-p chapter-tag chapter-tag--center\"><i class=\"ty-i-2\"></i><b class=\"ty-b-2\">00</b><em class=\"ty-em\">Arrival</em></p><p class=\"ty-p-2 gm-label label--center\" data-rv=\"\"><span class=\"gm-label-before\"></span>Request received</p><h1 class=\"ty-h1\" id=\"arrivalTitle\">Thank you \u2014 you're on the list</h1><p class=\"ty-arrival__sub\" data-rv=\"\"> Your consultation request has reached Grand Mission Dentistry in Richmond, TX. A member of the team will call you to confirm a time that works. Nothing else is needed from you right now. </p><div class=\"status__meta\" data-rv=\"stagger\"><span class=\"ty-span-2\"><strong class=\"ty-strong-2\">Where</strong>8620 Grand Mission Blvd Ste E, Richmond, TX 77407</span> <span class=\"ty-span-2\"><strong class=\"ty-strong-2\">Who</strong>Dr. William Sung, DMD \u00b7 Dr. Van Nguyen, DDS</span> <span class=\"ty-span-2\"><strong class=\"ty-strong-2\">Typical callback</strong>Same business day</span></div></div><script class=\"wz-js ty-emb-4 wz-js\" data-embed=\"\">\n/* CHAPTER 00 \u2014 ARRIVAL: the receipt stamp (SIGNATURE) + scrubbed departure. */\nWZ.add(function (W) {\n  var stamp = document.getElementById('stamp');\n  var path = document.getElementById('stampPath');\n  if (!stamp || !path) return;\n\n  var length = path.getTotalLength();\n  var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });\n\n  tl.from('#stampRing', { scale: 0.4, opacity: 0, duration: 0.55, ease: 'back.out(2)' })\n    .fromTo(\n      path,\n      { strokeDasharray: length, strokeDashoffset: length },\n      { strokeDashoffset: 0, duration: 0.6, ease: 'power2.inOut' },\n      '-=0.15'\n    )\n    /* The ripple starts at the ring's own size and expands past it. It never\n       settles on scale 1 \u2014 a transform landing exactly on 1 can flicker as\n       the browser re-rasterises. */\n    .fromTo(\n      '#stampRipple',\n      { scale: 1.02, opacity: 0.85 },\n      { scale: 1.85, opacity: 0, duration: 1.1, ease: 'power2.out' },\n      '-=0.35'\n    );\n\n  var title = document.getElementById('arrivalTitle');\n  var split = W.splitLines(title);\n  if (split && split.lines && split.lines.length) {\n    gsap.set(split.lines, { yPercent: 115 });\n    tl.to(split.lines, { yPercent: 0, duration: 1, stagger: 0.09, ease: 'power4.out' }, 0.45);\n  }\n\n  /* Departure \u2014 the whole confirmation recedes as you leave it. */\n  gsap\n    .timeline({ scrollTrigger: { trigger: '#arrival', start: 'top top', end: 'bottom top', scrub: 0.5 } })\n    .to('#arrivalInner', { yPercent: -14, opacity: 0.25, ease: 'none' }, 0)\n    .to('#stamp', { yPercent: -40, ease: 'none' }, 0)\n    .to('#arrivalImg', { yPercent: 6, scale: 1.08, ease: 'none' }, 0)\n    .to('#arrivalVeil', { opacity: 0.7, ease: 'none' }, 0);\n});\n</script></section><section class=\"gm-box ch ch--tight ch-fast-track\" id=\"fast-track\" data-chapter=\"1\" data-chapter-name=\"The Fast Track\"><div class=\"gm-box shell\"><div class=\"call-box\"><div class=\"call-box__copy\"><p class=\"ty-p-3 chapter-tag\"><i class=\"ty-i-2\"></i><b class=\"ty-b-2\">01</b><em class=\"ty-em-2\">The Fast Track</em></p><h2 class=\"ty-h2\" data-split=\"\">Call now and we'll book you on this call</h2><p class=\"lede\"> Calling gets you a time straight away instead of waiting for us to reach you. If the line is busy, leave a message \u2014 every one gets returned. </p><div class=\"call-box__actions\"><a class=\"ty-a-2 btn btn--lg magnetic\" href=\"#\" data-tel-link=\"\"><span class=\"btn-before\"></span><svg class=\"ty-emb-5 ty-svg-2\" aria-hidden=\"true\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\"><path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1.1 1A16 16 0 0 1 4 5.1 1 1 0 0 1 5 4Z\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"2\"></path></svg><span class=\"ty-span\">Call <span class=\"gm-box\" data-tel=\"\">(281) 789-8836</span></span></a> <a class=\"ty-a-2 btn btn--ghost btn--lg magnetic\" href=\"https://www.flexbook.me/gmdent/1\" target=\"_blank\" rel=\"noopener\"><span class=\"btn-before\"></span><span class=\"ty-span\">Book online instead</span></a></div></div><aside class=\"now\"><h3 class=\"ty-h3\">Is the practice open right now?</h3><p class=\"now__status\" id=\"openStatus\"><i class=\"now__dot\" aria-hidden=\"true\"></i> <span class=\"gm-box\" id=\"openStatusText\">Checking\u2026</span></p><p class=\"now__next\" id=\"openNext\"></p><p class=\"now__langs\">English, Spanish, Vietnamese, Korean and Arabic spoken.</p></aside></div></div><script class=\"wz-js ty-emb-4 wz-js\" data-embed=\"\">\n/* PRACTICE TOKENS + LIVE OPEN/CLOSED STATUS (Asana 1217162605683014).\n   Behaviour, not motion: runs at DOM-ready whatever GSAP says. A thank-you\n   page is read minutes after the form is submitted, so \"call us\" is only\n   useful if the visitor knows whether anyone is there to answer. Runs on the\n   visitor's clock; the practice is US Central, which is accurate for local\n   traffic \u2014 all a Richmond, TX campaign gets.\n\n   SHARED ARCHETYPE \u2014 Mason Park Dental has the identical 4-section spec.\n   To reuse: change PRACTICE below and the practice details in the markup. */\nWZ.onReady(function () {\n  var PRACTICE = {\n    phoneDisplay: '(281) 789-8836',\n    phoneDial: '+12817898836',\n    /* Opening hours as published on grandmissiondentistry.com (2026-08-05).\n       [openMinutes, closeMinutes] from midnight, or null when closed. The two\n       vendor landing pages publish two *different* hour sets; this is the\n       client's own current site, the one to trust until Brandklout confirms\n       otherwise. Keep this table and the visible <dl> in step. */\n    hours: {\n      0: null,\n      1: [9 * 60, 19 * 60],\n      2: [10 * 60, 20 * 60],\n      3: [10 * 60, 20 * 60],\n      4: [8 * 60, 18 * 60],\n      5: [8 * 60, 18 * 60],\n      6: [8 * 60, 15 * 60],\n    },\n  };\n  var DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n\n  document.querySelectorAll('[data-tel]').forEach(function (el) {\n    el.textContent = PRACTICE.phoneDisplay;\n  });\n  document.querySelectorAll('[data-tel-link]').forEach(function (el) {\n    el.setAttribute('href', 'tel:' + PRACTICE.phoneDial);\n  });\n\n  var statusEl = document.getElementById('openStatus');\n  var statusText = document.getElementById('openStatusText');\n  var nextEl = document.getElementById('openNext');\n  if (!statusEl || !statusText) return;\n\n  var now = new Date();\n  var day = now.getDay();\n  var minutes = now.getHours() * 60 + now.getMinutes();\n  var today = PRACTICE.hours[day];\n\n  var fmt = function (mins) {\n    var h24 = Math.floor(mins / 60);\n    var m = mins % 60;\n    var suffix = h24 >= 12 ? 'pm' : 'am';\n    var h12 = h24 % 12 === 0 ? 12 : h24 % 12;\n    return h12 + ':' + String(m).padStart(2, '0') + ' ' + suffix;\n  };\n\n  if (today && minutes >= today[0] && minutes < today[1]) {\n    statusText.textContent = 'Open now';\n    statusEl.classList.add('is-open');\n    nextEl.textContent = 'Closing at ' + fmt(today[1]) + ' today.';\n  } else {\n    statusText.textContent = 'Closed right now';\n    statusEl.classList.add('is-closed');\n    for (var step = 0; step < 8; step++) {\n      var d = (day + step) % 7;\n      var slot = PRACTICE.hours[d];\n      if (!slot) continue;\n      if (step === 0 && minutes >= slot[0]) continue; /* past today's open */\n      var label = step === 0 ? 'today' : step === 1 ? 'tomorrow' : DAY_NAMES[d];\n      nextEl.textContent =\n        'Opens ' + label + ' at ' + fmt(slot[0]) +\n        '. Leave a message and the team will call you back.';\n      break;\n    }\n  }\n\n  /* Highlight today's row in the hours list. */\n  var row = document.querySelector('#hoursList [data-day=\"' + day + '\"]');\n  if (row) row.classList.add('is-today');\n});\n</script><script class=\"wz-js ty-emb-4 wz-js\" data-embed=\"\">\n/* CHAPTER 01 \u2014 THE FAST TRACK: the call box rises into place. */\nWZ.add(function (W) {\n  var callBox = document.querySelector('.call-box');\n  if (!callBox) return;\n  gsap.from(callBox, {\n    y: 40,\n    opacity: 0,\n    duration: 0.9,\n    ease: 'power3.out',\n    scrollTrigger: { trigger: callBox, start: 'top 92%' },\n  });\n});\n</script></section><section class=\"ty-section ch ch--pin ch-path\" id=\"path\" data-chapter=\"2\" data-chapter-name=\"The Path\" data-theme=\"paper\"><div class=\"gm-box ch__pin path__pin\" id=\"pathPin\"><div class=\"gm-box shell path__head\"><p class=\"ty-p-3 chapter-tag\"><i class=\"ty-i-2\"></i><b class=\"ty-b-2\">02</b><em class=\"ty-em-2\">The Path</em></p><h2 class=\"ty-h2-2\" data-split=\"\">Three steps, no surprises</h2></div><div class=\"gm-box shell path__body\"><div class=\"path__rail\" aria-hidden=\"true\"><i class=\"ty-i-3\" id=\"pathRail\" data-scrub-probe=\"pathRail\"></i></div><ol class=\"steps\"><li class=\"stepc\" data-step-card=\"\"><span class=\"stepc__n\">1</span><h3 class=\"ty-h3-2\">We call you</h3><p class=\"ty-p-4\"> A member of the team calls to confirm your details and find an appointment time that suits you. Evening slots run until 8:00 pm on Tuesdays and Wednesdays. </p></li><li class=\"stepc\" data-step-card=\"\"><span class=\"stepc__n\">2</span><h3 class=\"ty-h3-2\">Your consultation</h3><p class=\"ty-p-4\"> You meet the dentist, we look at the area properly, and you get a clear recommendation. If you already have a plan from another office, bring it \u2014 the second opinion is free. </p></li><li class=\"stepc\" data-step-card=\"\"><span class=\"stepc__n\">3</span><h3 class=\"ty-h3-2\">Your plan and your price</h3><p class=\"ty-p-4\"> You leave knowing exactly what is recommended and what it costs, including what your insurance covers and which financing options apply. Nothing is booked until you say so. </p></li></ol></div></div><script class=\"wz-js ty-emb-4 wz-js\" data-embed=\"\">\n/* CHAPTER 02 \u2014 THE PATH (pinned, scrubbed): the rail draws through the\n   three steps. */\nWZ.add(function (W) {\n  var pin = document.getElementById('pathPin');\n  var railFill = document.getElementById('pathRail');\n  var cards = gsap.utils.toArray('[data-step-card]');\n  if (!pin || !railFill || !cards.length) return;\n\n  /* The rail runs along whichever axis the steps do at this width. */\n  var vertical = function () { return window.matchMedia('(max-width: 859px)').matches; };\n\n  var paint = function (p) {\n    gsap.set(railFill, vertical() ? { scaleY: p, scaleX: 1 } : { scaleX: p, scaleY: 1 });\n    cards.forEach(function (card, i) {\n      card.classList.toggle('is-active', p >= i / cards.length + 0.04);\n    });\n  };\n\n  var mm = gsap.matchMedia();\n  mm.add('(min-width: 760px)', function () {\n    return W.scrub(\n      { trigger: pin, start: 'top top', end: '+=130%', pin: true, scrub: 0.3, anticipatePin: 1, invalidateOnRefresh: true },\n      paint\n    );\n  });\n  mm.add('(max-width: 759px)', function () {\n    return W.scrub({ trigger: pin, start: 'top 78%', end: 'bottom 60%', scrub: 0.35 }, paint);\n  });\n\n  gsap.from(cards, {\n    y: 28,\n    opacity: 0,\n    duration: 0.8,\n    stagger: 0.12,\n    ease: 'power3.out',\n    scrollTrigger: { trigger: pin, start: 'top 82%' },\n  });\n});\n/* An unlit step list would read as a page that failed to load. */\nWZ.staticPaint(function () {\n  var rail = document.getElementById('pathRail');\n  if (rail) rail.style.transform = 'none';\n  document.querySelectorAll('[data-step-card]').forEach(function (c) { c.classList.add('is-active'); });\n});\n</script></section><section class=\"gm-box ch ch--pin ch-prep\" id=\"preparation\" data-chapter=\"3\" data-chapter-name=\"The Preparation\"><div class=\"gm-box ch__pin prep__pin\" id=\"prepPin\"><div class=\"gm-box shell prep__grid\"><div class=\"gm-box\"><p class=\"ty-p-3 chapter-tag\"><i class=\"ty-i-2\"></i><b class=\"ty-b-2\">03</b><em class=\"ty-em-2\">The Preparation</em></p><h2 class=\"ty-h2-3\" data-split=\"\">Two things worth bringing</h2><p class=\"lede\"> Nothing has to happen before we call. These just make the consultation faster, and they are the fastest way to know where you stand. </p></div><ol class=\"prep__list\" id=\"prepList\"><li class=\"prep__item\" data-prep=\"\"><span class=\"prep__n\">01</span><h3 class=\"ty-h3-3\">Your insurance card</h3><p class=\"ty-p-5\">So we can check your benefit and tell you what is covered before you commit to anything.</p></li><li class=\"prep__item\" data-prep=\"\"><span class=\"prep__n\">02</span><h3 class=\"ty-h3-3\">Any treatment plan you already have</h3><p class=\"ty-p-5\">Been given a plan by another office? Bring it. The second opinion is free, and it is the fastest way to know where you stand.</p></li><li class=\"prep__item\" data-prep=\"\"><span class=\"prep__n\">03</span><h3 class=\"ty-h3-3\">Nothing else</h3><p class=\"ty-p-5\">That really is it. Nothing else is needed from you right now \u2014 the next move is ours.</p></li></ol></div><div class=\"gm-box ch__rail ch__rail--shell\"><i class=\"ty-i-4\" id=\"prepBar\" data-scrub-probe=\"prepBar\"></i></div></div><script class=\"wz-js ty-emb-4 wz-js\" data-embed=\"\">\n/* CHAPTER 03 \u2014 THE PREPARATION (pinned, scrubbed): the two things worth\n   bringing. */\nWZ.add(function (W) {\n  var pin = document.getElementById('prepPin');\n  var items = gsap.utils.toArray('[data-prep]');\n  var bar = document.getElementById('prepBar');\n  if (!pin || !items.length) return;\n\n  var paint = function (p) {\n    if (bar) gsap.set(bar, { scaleX: p });\n    items.forEach(function (item, i) {\n      item.classList.toggle('is-active', p >= i / items.length + 0.03);\n    });\n  };\n\n  var mm = gsap.matchMedia();\n  mm.add('(min-width: 760px)', function () {\n    return W.scrub(\n      { trigger: pin, start: 'top top', end: '+=120%', pin: true, scrub: 0.3, anticipatePin: 1, invalidateOnRefresh: true },\n      paint\n    );\n  });\n  mm.add('(max-width: 759px)', function () {\n    return W.scrub({ trigger: pin, start: 'top 80%', end: 'bottom 58%', scrub: 0.35 }, paint);\n  });\n});\nWZ.staticPaint(function () {\n  document.querySelectorAll('[data-prep]').forEach(function (p) { p.classList.add('is-active'); });\n});\n</script></section><section class=\"ty-section ch ch-team\" id=\"team\" data-recede=\"\" data-chapter=\"4\" data-chapter-name=\"The Team\" data-theme=\"paper\"><div class=\"gm-box shell\"><div class=\"ty-head\" data-rv=\"\"><p class=\"ty-p-3 chapter-tag\"><i class=\"ty-i-2\"></i><b class=\"ty-b-2\">04</b><em class=\"ty-em-2\">The Team</em></p><h2 class=\"ty-h2-2\" data-split=\"\">Who you'll actually meet</h2></div><div class=\"gm-box gm-grid c3\" data-rv=\"stagger\"><article class=\"gm-card\" data-cursor-card=\"\"><h3 class=\"ty-h3-3\">Dr. William Sung, DMD</h3><p class=\"ty-p-6\">General, restorative and implant dentistry.</p></article><article class=\"gm-card\" data-cursor-card=\"\"><h3 class=\"ty-h3-3\">Dr. Van Nguyen, DDS</h3><p class=\"ty-p-6\">Restorative and cosmetic dentistry.</p></article><article class=\"gm-card\" data-cursor-card=\"\"><h3 class=\"ty-h3-3\">Dr. Tam Nguyen, DMD</h3><p class=\"ty-p-6\">Board-certified pediatric dentist.</p></article></div><figure class=\"team__media\"><div class=\"gm-box gm-figure figure--4x3\" data-wipe=\"up\"><img class=\"ty-img-2\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/69b2b3fadc35de3b8a991be4_imgi_57_GrandMissionDentistry-115-2048x1362.webp\" alt=\"Dr. William Sung reviewing a 3D dental scan with a patient at Grand Mission Dentistry\" width=\"auto\" height=\"auto\" loading=\"eager\" data-drift=\"6\"></div><figcaption class=\"ty-figcaption\" data-rv=\"\"> Consultations are done in front of your own scan \u2014 you see what the dentist sees. English, Spanish, Vietnamese, Korean and Arabic are all spoken here. </figcaption></figure></div></section><section class=\"ty-section-2 ch ch--pin ch-place\" id=\"place\" data-chapter=\"5\" data-chapter-name=\"The Place\" data-theme=\"tint\"><div class=\"gm-box ch__pin place__pin\" id=\"placePin\"><div class=\"gm-box shell place__grid\"><div class=\"place__panel\"><p class=\"ty-p-3 chapter-tag\"><i class=\"ty-i-2\"></i><b class=\"ty-b-2\">05</b><em class=\"ty-em-2\">The Place</em></p><h2 class=\"ty-h2-4\" data-split=\"\">Grand Mission Dentistry of Richmond</h2><div class=\"place__list\"><span class=\"place__marker\" id=\"placeMarker\" data-scrub-probe=\"placeMarker\" aria-hidden=\"true\"></span><ol class=\"place__details\" id=\"placeDetails\"><li class=\"detail\" data-detail=\"\"><h3 class=\"ty-h3-4\">Address</h3><p class=\"ty-p-7\">8620 Grand Mission Blvd Ste E<span class=\"br-line\">Richmond, TX 77407</span></p><a class=\"gm-more\" href=\"https://maps.app.goo.gl/h8xXwxeF26pKio8n6\" target=\"_blank\" rel=\"noopener\">Get directions<span class=\"gm-more-after\">\u2192</span></a></li><li class=\"detail\" data-detail=\"\"><h3 class=\"ty-h3-4\">Contact</h3><p class=\"ty-p-7\"><a class=\"ty-a-3\" href=\"#\" data-tel-link=\"\" data-tel=\"\">(281) 789-8836</a><span class=\"br-line\"><a class=\"ty-a-3\" href=\"https://www.flexbook.me/gmdent/1\" target=\"_blank\" rel=\"noopener\">Book online</a></span></p></li><li class=\"detail\" data-detail=\"\"><h3 class=\"ty-h3-4\">Office hours</h3><dl class=\"ty-hours hours--light ty-emb-6 ty-hours hours--light\" id=\"hoursList\">\n<div class=\"ty-emb-7\" data-day=\"1\"><dt class=\"ty-emb-8\">Monday</dt><dd class=\"ty-emb-9\">9:00 am \u2013 7:00 pm</dd></div>\n<div class=\"ty-emb-7\" data-day=\"2\"><dt class=\"ty-emb-8\">Tuesday</dt><dd class=\"ty-emb-9\">10:00 am \u2013 8:00 pm</dd></div>\n<div class=\"ty-emb-7\" data-day=\"3\"><dt class=\"ty-emb-8\">Wednesday</dt><dd class=\"ty-emb-9\">10:00 am \u2013 8:00 pm</dd></div>\n<div class=\"ty-emb-7\" data-day=\"4\"><dt class=\"ty-emb-8\">Thursday</dt><dd class=\"ty-emb-9\">8:00 am \u2013 6:00 pm</dd></div>\n<div class=\"ty-emb-7\" data-day=\"5\"><dt class=\"ty-emb-8\">Friday</dt><dd class=\"ty-emb-9\">8:00 am \u2013 6:00 pm</dd></div>\n<div class=\"ty-emb-7\" data-day=\"6\"><dt class=\"ty-emb-8\">Saturday</dt><dd class=\"ty-emb-9\">8:00 am \u2013 3:00 pm</dd></div>\n<div class=\"ty-emb-7\" data-day=\"0\"><dt class=\"ty-emb-8\">Sunday</dt><dd class=\"ty-emb-9\">Closed</dd></div>\n</dl></li></ol></div></div><div class=\"place__map\" id=\"placeMap\"><div data-embed-slot=\"0\" class=\"ty-iframe\"></div></div></div><div class=\"gm-box ch__rail ch__rail--shell\"><i class=\"ty-i-4\" id=\"placeBar\"></i></div></div><script class=\"wz-js ty-emb-4 wz-js\" data-embed=\"\">\n/* CHAPTER 05 \u2014 THE PLACE (pinned, scrubbed): a marker travels the practice\n   details while the map settles behind them. */\nWZ.add(function (W) {\n  var pin = document.getElementById('placePin');\n  var list = document.getElementById('placeDetails');\n  var marker = document.getElementById('placeMarker');\n  var details = gsap.utils.toArray('[data-detail]');\n  var map = document.getElementById('placeMap');\n  var bar = document.getElementById('placeBar');\n  if (!pin || !list || !marker || !details.length) return;\n\n  var paint = function (p) {\n    var span = list.clientHeight - marker.clientHeight;\n    gsap.set(marker, { y: span * p });\n    details.forEach(function (d, i) {\n      d.classList.toggle('is-on', p >= i / details.length && p < (i + 1) / details.length + 0.001);\n    });\n    /* The map settles as the panel is read. Scale stays above 1 at both ends\n       so the frame never lands exactly on 1 and flickers its edge. */\n    if (map) gsap.set(map, { scale: 1.06 - 0.045 * p });\n    if (bar) gsap.set(bar, { scaleX: p });\n  };\n\n  var mm = gsap.matchMedia();\n  mm.add('(min-width: 760px)', function () {\n    return W.scrub(\n      { trigger: pin, start: 'top top', end: '+=120%', pin: true, scrub: 0.3, anticipatePin: 1, invalidateOnRefresh: true },\n      paint\n    );\n  });\n  mm.add('(max-width: 759px)', function () {\n    return W.scrub({ trigger: pin, start: 'top 78%', end: 'bottom 60%', scrub: 0.35 }, paint);\n  });\n});\nWZ.staticPaint(function () {\n  document.querySelectorAll('[data-detail]').forEach(function (d) { d.classList.add('is-on'); });\n});\n</script></section></main><footer class=\"gm-footer\"><div class=\"gm-box shell\"><div class=\"footer__grid\"><div class=\"gm-box\"><img class=\"footer__logo\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7cee705fbdbf789cecc_logo-light.webp\" alt=\"Grand Mission Dentistry\" width=\"auto\" height=\"auto\" loading=\"eager\"><p class=\"ty-p-3\">Grand Mission Dentistry of Richmond<span class=\"br-line\">8620 Grand Mission Blvd Ste E</span><span class=\"br-line\">Richmond, TX 77407</span></p><p class=\"ty-p-8\"><a class=\"ty-a-4\" href=\"#\" data-tel-link=\"\" data-tel=\"\">(281) 789-8836</a></p></div><div class=\"gm-box\"><h3 class=\"ty-h3-5\">Your dentists</h3><p class=\"ty-p-3\"> Dr. William Sung, DMD \u2014 general, restorative and implant dentistry<span class=\"br-line\"> Dr. Van Nguyen, DDS \u2014 restorative and cosmetic dentistry</span><span class=\"br-line\"> Dr. Tam Nguyen, DMD \u2014 board-certified pediatric dentist </span></p></div><div class=\"gm-box\"><h3 class=\"ty-h3-5\">While you wait</h3><p cl