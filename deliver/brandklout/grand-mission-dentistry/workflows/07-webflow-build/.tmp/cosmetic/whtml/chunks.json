 {
  "key": "c0",
  "parent": null,
  "html": "<div class=\"cos-page\"><a class=\"sr-only\" href=\"#book\">Skip to the consultation form</a><header class=\"gm-header\" id=\"header\"><div class=\"gm-box shell header__inner\"><a class=\"header__logo\" href=\"#arrival\" aria-label=\"Grand Mission Dentistry\"><img class=\"logo-light\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7cee705fbdbf789cecc_logo-light.webp\" alt=\"Grand Mission Dentistry\" width=\"auto\" height=\"auto\" loading=\"eager\"><img class=\"logo-dark\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7cd42ae23ca5e859fdb_logo-dark.webp\" alt=\"Grand Mission Dentistry\" width=\"auto\" height=\"auto\" loading=\"eager\"></a><div class=\"header__chapter\" id=\"chapterReadout\" aria-hidden=\"true\"><b class=\"cos-b\" id=\"chNum\">00</b><span class=\"gm-box\" id=\"chName\">Arrival</span><i class=\"cos-i\" id=\"chBar\"></i></div><div class=\"header__actions\"><a class=\"header__phone\" href=\"#\" data-tel-link=\"\"><svg class=\"cos-emb-1 cos-svg\" aria-hidden=\"true\" fill=\"none\" height=\"20\" viewbox=\"0 0 24 24\" width=\"20\">\n<path d=\"M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1.1 1A16 16 0 0 1 4 5.1 1 1 0 0 1 5 4Z\" stroke=\"currentColor\" stroke-linejoin=\"round\" stroke-width=\"2\"></path>\n</svg><span class=\"header__phone-text\"><small class=\"cos-emb-2 cos-small\">Call the practice</small> <strong class=\"cos-strong\" data-tel=\"\">(281) 729-4615</strong></span></a> <a class=\"cos-a btn magnetic\" href=\"#book\"><span class=\"btn-before\"></span><span class=\"lbl-lg\">Book a free consultation</span><span class=\"lbl-sm\">Book</span></a></div></div><div class=\"header__progress\" id=\"readProgress\"></div></header><div class=\"cos-div-2\" id=\"smooth-wrapper\"><div class=\"gm-box\" id=\"smooth-content\"><main class=\"gm-box\" id=\"top\"><section class=\"gm-box ch cos-ch-arrival\" id=\"arrival\" data-chapter=\"0\" data-chapter-name=\"Arrival\"><div class=\"arrival__media\"><img class=\"cos-img\" id=\"arrivalImg\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c83b8fcef54d6502f0_cosmetic-patient.jpeg\" width=\"auto\" height=\"auto\" loading=\"eager\" aria-hidden=\"true\"><div class=\"arrival__media-after\"></div></div><div class=\"arrival__aurora\" aria-hidden=\"true\"></div><div class=\"arrival__veil\" id=\"arrivalVeil\" aria-hidden=\"true\"></div><div class=\"gm-box shell arrival__inner\" id=\"arrivalInner\"><div class=\"arrival__copy\"><p class=\"cos-p chapter-tag\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">00</b><em class=\"cos-em\">Arrival</em></p><p class=\"gm-box gm-label\" data-rv=\"\"><span class=\"gm-label-before\"></span>Cosmetic dentistry \u00b7 Richmond, TX</p><h1 class=\"cos-h1\" id=\"arrivalTitle\">Your trusted destination for <em class=\"cos-em-2\">cosmetic dentistry</em> in Richmond, TX</h1><p class=\"cos-arrival__sub\" data-rv=\"\">Advanced care and tailored solutions for a stunning smile.</p><div class=\"offer\" data-rv=\"\"><p class=\"cos-p\"><span class=\"script\">Free</span></p><p class=\"offer__meta\"><strong class=\"cos-strong-2\">Second opinion available</strong> Already have a treatment plan from another office? Bring it in. No cost, no pressure \u2014 just a straight answer about what your smile actually needs. </p></div><ul class=\"ticks\" data-rv=\"stagger\"><li class=\"cos-li\"><i class=\"cos-i-3\" aria-hidden=\"true\"><span class=\"i-after\"></span></i>Two cosmetic dentists \u2014 Dr. William Sung, DMD and Dr. Van Nguyen, DDS</li><li class=\"cos-li\"><i class=\"cos-i-3\" aria-hidden=\"true\"><span class=\"i-after\"></span></i>New patient special: $<span class=\"gm-box\" data-offer=\"new-patient-value\">189</span> \u2014 exam, X-rays, cleaning and treatment plan</li><li class=\"cos-li\"><i class=\"cos-i-3\" aria-hidden=\"true\"><span class=\"i-after\"></span></i>Composites, veneers, Invisalign and teeth whitening under one roof</li><li class=\"cos-li\"><i class=\"cos-i-3\" aria-hidden=\"true\"><span class=\"i-after\"></span></i>English, Spanish, Vietnamese, Korean and Arabic spoken</li></ul><div class=\"proof\" data-rv=\"stagger\"><span class=\"proof__item\"><span class=\"gm-stars\" aria-hidden=\"true\">\u2605\u2605\u2605\u2605\u2605</span> <strong class=\"cos-strong-3\">1,700+</strong> Google reviews </span> <span class=\"proof__item\"><strong class=\"cos-strong-3\">2021\u20132024</strong> Nextdoor Neighborhood Favorite </span> <span class=\"proof__item\"><strong class=\"cos-strong-3\">Healthgrades</strong> 2023 Patient Safety Award </span></div></div><div class=\"panel\" id=\"book\"><div class=\"panel__head\"><h2 class=\"cos-h2\">Book your free consultation</h2><p class=\"cos-p-2\">Schedule an appointment with our cosmetic team.</p></div><div data-embed-slot=\"0\" class=\"panel__body\"></div><div class=\"panel__success\" id=\"formSuccess\" role=\"status\"><div class=\"success-mark\" aria-hidden=\"true\"><svg class=\"cos-emb-1 cos-svg\" fill=\"none\" height=\"30\" viewbox=\"0 0 24 24\" width=\"30\">\n<path d=\"m5 13 4 4L19 7\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\"></path>\n</svg></div><h2 class=\"cos-h2-2\">Your request is in</h2><p class=\"cos-p\"> Our cosmetic team will call you shortly to book your consultation. If you'd rather not wait, call <a class=\"header__logo\" href=\"#\" data-tel-link=\"\"><strong class=\"gm-box\" data-tel=\"\">(281) 729-4615</strong></a> now. </p></div></div></div><a class=\"scroll-cue\" href=\"#hands\" aria-label=\"Begin\"><span class=\"cos-span\"></span></a><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* CHAPTER 00 \u2014 ARRIVAL: entrance timeline + scrubbed departure. */\nWZ.add(function (W) {\n  var root = document.getElementById('arrival');\n  if (!root) return;\n\n  var tl = gsap.timeline({ delay: 0.12, defaults: { ease: 'power3.out' } });\n  var title = document.getElementById('arrivalTitle');\n  var split = W.splitLines(title);\n\n  if (split && split.lines && split.lines.length) {\n    gsap.set(split.lines, { yPercent: 115 });\n    tl.to(split.lines, { yPercent: 0, duration: 1.1, stagger: 0.09, ease: 'power4.out' }, 0);\n  } else {\n    tl.from(title, { opacity: 0, y: 40, duration: 1 }, 0);\n  }\n  tl.from(root.querySelector('.chapter-tag'), { opacity: 0, x: -22, duration: 0.85 }, 0.05)\n    .from('#arrivalImg', { opacity: 0, scale: 1.12, duration: 1.7 }, 0)\n    .from('#book', { opacity: 0, y: 40, duration: 1 }, 0.5);\n\n  /* Departure. */\n  gsap\n    .timeline({ scrollTrigger: { trigger: root, start: 'top top', end: 'bottom top', scrub: 0.5 } })\n    .to('#arrivalInner', { yPercent: -12, opacity: 0.2, ease: 'none' }, 0)\n    .to('#arrivalImg', { yPercent: 6, scale: 1.1, ease: 'none' }, 0)\n    .to('#arrivalVeil', { opacity: 0.75, ease: 'none' }, 0);\n});\n</script><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* OFFER + LEAD LAYER \u2014 single source of truth for every price and phone\n   number on the page (Asana 1217072657902270). Behaviour, not motion: runs at\n   DOM-ready whatever GSAP or prefers-reduced-motion say, before the kit's\n   counters read data-count (the boot gate guarantees that order). */\nWZ.onReady(function () {\n  var OFFER = {\n    /* Live offers published on grandmissiondentistry.com (2026-08-05). */\n    newPatient: 189, /* exam, X-rays, cleaning, treatment plan */\n    invisalign: 3799, /* aligners, refinements, retainer, whitening */\n    /* The cosmetic campaign's own call-tracking number, as published on the\n       vendor original \u2014 distinct from the implant page's, which is the point\n       of tracking numbers. OPEN with Brandklout: if it belongs to the\n       outgoing ad company it may be disconnected at handover. Fallback is\n       the main line, (281) 789-8836 / +12817898836. */\n    phoneDisplay: '(281) 729-4615',\n    phoneDial: '+12817294615',\n  };\n  /* GHL lead destination \u2014 null until Brandklout hands over the endpoint. */\n  var LEAD_ENDPOINT = null;\n  var THANK_YOU_URL = null;\n\n  var text = {\n    'new-patient-value': OFFER.newPatient.toLocaleString('en-US'),\n    'invisalign-value': OFFER.invisalign.toLocaleString('en-US'),\n  };\n  Object.keys(text).forEach(function (key) {\n    document.querySelectorAll('[data-offer=\"' + key + '\"]').forEach(function (el) {\n      el.textContent = text[key];\n    });\n  });\n\n  /* Counters get the number, not the string. */\n  var counters = { 'new-patient': OFFER.newPatient, invisalign: OFFER.invisalign };\n  Object.keys(counters).forEach(function (key) {\n    document.querySelectorAll('[data-offer-count=\"' + key + '\"]').forEach(function (el) {\n      el.setAttribute('data-count', String(counters[key]));\n      el.textContent = counters[key].toLocaleString('en-US');\n    });\n  });\n\n  document.querySelectorAll('[data-tel]').forEach(function (el) {\n    el.textContent = OFFER.phoneDisplay;\n  });\n  document.querySelectorAll('[data-tel-link]').forEach(function (el) {\n    el.setAttribute('href', 'tel:' + OFFER.phoneDial);\n  });\n\n  /* ---------- lead form -------------------------------------------------- */\n  var panel = document.getElementById('book');\n  var form = document.getElementById('leadForm');\n  var submit = document.getElementById('formSubmit');\n  if (!panel || !form) return;\n\n  form.addEventListener('submit', function (event) {\n    event.preventDefault();\n    if (!validate()) return;\n\n    /* Honeypot: a bot fills every field it finds, a patient never sees it. */\n    if (form.company_website && form.company_website.value) return;\n\n    var data = {};\n    new FormData(form).forEach(function (value, key) { data[key] = value; });\n    data.page = 'cosmetic-landing-page';\n    data.asana_task_gid = '1217072657902270';\n\n    var finish = function () {\n      panel.classList.add('is-done');\n      if (window.ScrollTrigger) ScrollTrigger.refresh();\n      if (window.WZ && WZ.smoother) WZ.smoother.scrollTo(panel, true, 'center center');\n      else panel.scrollIntoView({ block: 'center' });\n    };\n\n    if (!LEAD_ENDPOINT) {\n      console.info('[lead] would POST to GHL:', data);\n      finish();\n      return;\n    }\n\n    submit.disabled = true;\n    submit.querySelector('span').textContent = 'Sending\u2026';\n    fetch(LEAD_ENDPOINT, {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(data),\n    })\n      .then(function () {\n        if (THANK_YOU_URL) { window.location.href = THANK_YOU_URL; return; }\n        finish();\n      })\n      .catch(function () {\n        submit.disabled = false;\n        submit.querySelector('span').textContent = 'Request my consultation';\n        var slot = form.querySelector('[data-error-for=\"f-consent\"]');\n        if (slot) slot.textContent = 'Something went wrong. Please call the practice instead.';\n      });\n  });\n\n  function validate() {\n    form.querySelectorAll('[aria-invalid]').forEach(function (el) {\n      el.removeAttribute('aria-invalid');\n    });\n    form.querySelectorAll('.field__error').forEach(function (el) { el.textContent = ''; });\n\n    var ok = true;\n    form.querySelectorAll('input[required]').forEach(function (input) {\n      var valid =\n        input.type === 'checkbox'\n          ? input.checked\n          : input.value.trim() !== '' && input.checkValidity();\n      if (!valid) {\n        ok = false;\n        input.setAttribute('aria-invalid', 'true');\n        var slot = form.querySelector('[data-error-for=\"' + input.id + '\"]');\n        if (slot) {\n          slot.textContent =\n            input.type === 'checkbox'\n              ? 'Please agree to the terms so we can contact you.'\n              : input.value.trim() === ''\n              ? 'This one is required.'\n              : 'Please check this is correct.';\n        }\n      }\n    });\n    return ok;\n  }\n});\n</script></section><section class=\"cos-section ch ch-hands\" id=\"hands\" data-recede=\"\" data-chapter=\"1\" data-chapter-name=\"The Hands\" data-theme=\"paper\"><div class=\"gm-box shell\"><div class=\"gm-box cos-head head--center\" data-rv=\"\"><p class=\"cos-p chapter-tag chapter-tag--center\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">01</b><em class=\"cos-em-3\">The Hands</em></p><h2 class=\"cos-h2-2\" data-split=\"\">Expert care you can trust</h2></div><div class=\"doctors\"><article class=\"gm-box doc\" data-doc=\"\"><div class=\"gm-box doc__portrait\"><div class=\"gm-box gm-figure figure--1x1\" data-wipe=\"up\"><img class=\"cos-img-2\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c9cb4cbbb84092168b_dr-sung.jpeg\" alt=\"Dr. William Sung, DMD\" width=\"auto\" height=\"auto\" loading=\"eager\" data-drift=\"4\"></div><div class=\"doc__portrait-after\"></div></div><div class=\"gm-box\"><h3 class=\"cos-h3\" data-split=\"\">Dr. William Sung, DMD</h3><p class=\"doc__role\" data-rv=\"\">Cosmetic &amp; restorative dentistry</p><p class=\"cos-p-3\" data-rv=\"\"> Dr. William Sung is highly regarded in the field of cosmetic dentistry, known for his commitment to patient-centered care and meticulous attention to detail. With extensive training in advanced cosmetic procedures, Dr. Sung has helped countless patients in Richmond, TX, achieve their ideal smiles. Trust in his expertise to guide your dental care journey with precision and compassion. You can also schedule virtual consultations with Dr. Sung. </p></div></article><article class=\"gm-box doc doc--rev\" data-doc=\"\"><div class=\"cos-div-3 doc__portrait\"><div class=\"gm-box gm-figure figure--1x1\" data-wipe=\"up\"><img class=\"cos-img-2\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c93edb81031dcf8b2f_dr-van.jpeg\" alt=\"Dr. Van Nguyen, DDS\" width=\"auto\" height=\"auto\" loading=\"eager\" data-drift=\"4\"></div><div class=\"doc__portrait-after-2\"></div></div><div class=\"gm-box\"><h3 class=\"cos-h3\" data-split=\"\">Dr. Van Nguyen, DDS</h3><p class=\"doc__role\" data-rv=\"\">Restorative &amp; cosmetic dentistry</p><p class=\"cos-p-3\" data-rv=\"\"> Dr. Van Nguyen, originally from Vietnam and raised in a small town in Minnesota, earned her Doctor of Dental Surgery degree from the University of Minnesota. Inspired by her hometown dentist, Dr. Nguyen is passionate about building lasting relationships with her patients and guiding them on their oral health journeys. With a love for art and precision, Dr. Nguyen excels in restorative and cosmetic dentistry and stays current with new techniques through continuing education. </p></div></article></div><p class=\"doctors__note\" data-rv=\"\"> Schedule your consultation at Grand Mission Dentistry in Richmond, TX, and experience advanced cosmetic care with a personal touch. </p><div class=\"cos-div-4\" data-rv=\"\"><a class=\"cos-a-2 btn magnetic\" href=\"#book\"><span class=\"btn-before\"></span><span class=\"cos-span-2\">Schedule an appointment</span></a></div></div><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* CHAPTER 01 \u2014 THE HANDS: the two portraits counter-drift so the pair never\n   sits completely still. */\nWZ.add(function (W) {\n  gsap.utils.toArray('[data-doc]').forEach(function (doc, i) {\n    gsap.fromTo(\n      doc.querySelector('.doc__portrait'),\n      { yPercent: i % 2 ? 5 : -5 },\n      {\n        yPercent: i % 2 ? -5 : 5,\n        ease: 'none',\n        scrollTrigger: { trigger: doc, start: 'top bottom', end: 'bottom top', scrub: 0.7 },\n      }\n    );\n  });\n});\n</script></section><section class=\"gm-box ch ch--pin ch-work\" id=\"work\" data-chapter=\"2\" data-chapter-name=\"The Work\"><div class=\"gm-box ch__pin work__pin\" id=\"workPin\"><div class=\"gm-box shell work__grid\"><div class=\"work__stage\"><p class=\"cos-p chapter-tag\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">02</b><em class=\"cos-em-3\">The Work</em></p><span class=\"work__count\"><b class=\"cos-b-3\" id=\"workNum\">01</b>/06</span><div class=\"work__card\" id=\"workCard\" data-scrub-probe=\"workCard\"><img class=\"work__icon\" id=\"workIcon\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7ca8167305332c548bd_icon-1.svg\" width=\"auto\" height=\"auto\" loading=\"eager\" aria-hidden=\"true\"><h2 class=\"cos-h2-3\" id=\"workTitle\">Preventive Dentistry</h2><p class=\"cos-p-4\" id=\"workTag\">Transform your smile with a touch of perfection.</p></div></div><div class=\"work__list\"><span class=\"work__marker\" id=\"workMarker\" data-scrub-probe=\"workMarker\" aria-hidden=\"true\"></span><ol class=\"work__index\" id=\"workIndex\"><li class=\"work__row\" data-svc=\"\" data-icon=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7ca8167305332c548bd_icon-1.svg\" data-tag=\"Transform your smile with a touch of perfection.\">Preventive Dentistry</li><li class=\"work__row\" data-svc=\"\" data-icon=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f8fc6bf43f8e2ff21056_icon-2.svg\" data-tag=\"Seamless solutions for a flawless smile.\">Children's Dentistry</li><li class=\"work__row\" data-svc=\"\" data-icon=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f8fd3edb81031dcfd7f6_icon-3.svg\" data-tag=\"A crown fit for your beautiful smile.\">Cosmetic Dentistry</li><li class=\"work__row\" data-svc=\"\" data-icon=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f8fdc490cc1bb6fcbea9_icon-4.svg\" data-tag=\"Because every smile deserves to shine.\">Smile Makeovers</li><li class=\"work__row\" data-svc=\"\" data-icon=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f8fe3b8fcef54d65512e_icon-5.svg\" data-tag=\"Fillings that blend for a naturally beautiful smile.\">Composite Fillings</li><li class=\"work__row\" data-svc=\"\" data-icon=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f8fe56d88a2341f3f66d_icon-6.svg\" data-tag=\"Brighten your smile, light up your world.\">Teeth Whitening</li></ol></div></div><div class=\"gm-box ch__rail ch__rail--shell\"><i class=\"cos-i-4\" id=\"workRail\"></i></div></div><div class=\"gm-box shell\"><div class=\"offers\" data-rv=\"\" data-count-scope=\"\"><div class=\"gm-box\"><h3 class=\"cos-h3-2\">New patient special \u2014 $<span class=\"gm-box\" data-offer-count=\"new-patient\" data-count=\"189\">189</span></h3><p class=\"cos-p-5\">Includes exam, X-rays, cleaning and treatment plan.</p><p class=\"offers__fine\"> Cannot be combined with insurance, new patients only, not valid in cases of periodontal disease. </p></div><div class=\"gm-box\"><h3 class=\"cos-h3-2\">Invisalign\u00ae \u2014 $<span class=\"gm-box\" data-offer-count=\"invisalign\" data-count=\"3799\">3,799</span></h3><p class=\"cos-p-5\">Includes aligners, refinements, retainer and whitening.</p><p class=\"offers__fine\">Limited-time special. Ask at your consultation.</p></div><a class=\"cos-a-2 btn btn--light magnetic\" href=\"#book\"><span class=\"btn-before-2\"></span><span class=\"cos-span-2\">Schedule a consultation today</span></a></div></div><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* CHAPTER 02 \u2014 THE WORK (pinned, scrubbed index): a marker travels the\n   service index and the stage changes to whatever it has reached. */\nWZ.add(function (W) {\n  var pin = document.getElementById('workPin');\n  var rows = gsap.utils.toArray('[data-svc]');\n  var marker = document.getElementById('workMarker');\n  var card = document.getElementById('workCard');\n  var icon = document.getElementById('workIcon');\n  var title = document.getElementById('workTitle');\n  var tag = document.getElementById('workTag');\n  var num = document.getElementById('workNum');\n  var rail = document.getElementById('workRail');\n  var index = document.getElementById('workIndex');\n  if (!pin || !rows.length || !marker) return;\n\n  var current = -1;\n\n  var show = function (i) {\n    if (i === current) return;\n    current = i;\n    var row = rows[i];\n    /* The stage swaps rather than cross-fades: one element, one owner of\n       opacity, so nothing can be stranded half-visible. */\n    gsap.fromTo(\n      card,\n      { opacity: 0, y: 18 },\n      { opacity: 1, y: 0, duration: 0.45, ease: 'power3.out', overwrite: true }\n    );\n    icon.src = row.getAttribute('data-icon');\n    title.textContent = row.textContent.trim();\n    tag.textContent = row.getAttribute('data-tag');\n    num.textContent = String(i + 1).padStart(2, '0');\n    rows.forEach(function (r, j) { r.classList.toggle('is-on', j === i); });\n  };\n\n  var paint = function (p) {\n    /* The marker is the continuous readout: it travels the whole index in\n       step with scroll, independently of which row happens to be active. */\n    var span = index.clientHeight - marker.clientHeight;\n    gsap.set(marker, { y: span * p });\n    show(Math.min(rows.length - 1, Math.floor(p * rows.length * 0.999)));\n    if (rail) gsap.set(rail, { scaleX: p });\n  };\n\n  var mm = gsap.matchMedia();\n  mm.add('(min-width: 760px)', function () {\n    return W.scrub(\n      { trigger: pin, start: 'top top', end: '+=190%', pin: true, scrub: 0.3, anticipatePin: 1, invalidateOnRefresh: true },\n      paint\n    );\n  });\n  mm.add('(max-width: 759px)', function () {\n    return W.scrub({ trigger: pin, start: 'top 78%', end: 'bottom 55%', scrub: 0.35 }, paint);\n  });\n});\n/* Without the pin the index cannot drive the stage, so the six services\n   become a plain list and the stage shows the first of them. */\nWZ.staticPaint(function () {\n  document.querySelectorAll('[data-svc]').forEach(function (r) { r.classList.add('is-on'); });\n});\n</script></section><section class=\"cos-section-2 ch ch-standard\" id=\"standard\" data-chapter=\"3\" data-chapter-name=\"The Standard\" data-theme=\"tint\"><div class=\"gm-box shell\"><div class=\"split\"><div class=\"gm-box\"><div class=\"gm-box gm-figure figure--4x3\" data-wipe=\"left\"><img class=\"cos-img-2\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7ce771fbf0c79c273b0_office-tech.jpeg\" alt=\"Treatment technology at Grand Mission Dentistry, Richmond, TX\" width=\"auto\" height=\"auto\" loading=\"eager\" data-drift=\"6\"></div></div><div class=\"gm-box\"><p class=\"cos-p chapter-tag\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">03</b><em class=\"cos-em-3\">The Standard</em></p><h2 class=\"cos-h2-2\" data-split=\"\">Boost your confidence</h2><p class=\"cos-p-6 lede\" data-rv=\"\"> At Grand Mission Dentistry, we believe a cosmetic dentist can boost your confidence with sparkling white teeth. Our cosmetic dentist in Richmond, TX is here to help you create your brand new, mega-watt smile, one that is unique to you. When it comes to your teeth, you should never settle for anything less than the best. We are prepared to hand-craft your teeth using a number of services such as composites, veneers, Invisalign and teeth whitening. Call us today for a consultation \u2014 your gorgeous new smile is just a phone call away. </p><a class=\"cos-a-3 btn btn--ghost magnetic\" href=\"#book\" data-rv=\"\"><span class=\"btn-before\"></span><span class=\"cos-span-2\">Connect to know more</span></a></div></div></div><div class=\"gm-box ch__pin pillars__pin\" id=\"pillarsPin\"><div class=\"gm-box shell pillars\"><div class=\"gm-box\"><p class=\"gm-box gm-label\"><span class=\"gm-label-before\"></span>Why us</p><h2 class=\"cos-h2-4\" data-split=\"\">Why choose Grand Mission Dentistry, Richmond, TX?</h2></div><div class=\"pillars__list\" id=\"pillarList\"><article class=\"pillar\" data-pillar=\"\"><span class=\"pillar__n\">01</span><h3 class=\"cos-h3-3\">State-of-the-art technology</h3><p class=\"cos-p-7\">We utilize cutting-edge equipment for precise and effective treatments.</p></article><article class=\"pillar\" data-pillar=\"\"><span class=\"pillar__n\">02</span><h3 class=\"cos-h3-3\">Personalized care</h3><p class=\"cos-p-7\">Our treatment plans are tailored to meet your unique smile goals.</p></article><article class=\"pillar\" data-pillar=\"\"><span class=\"pillar__n\">03</span><h3 class=\"cos-h3-3\">Experienced team</h3><p class=\"cos-p-7\">Trusted by the Richmond, TX community for quality and professionalism.</p></article></div></div><div class=\"gm-box ch__rail ch__rail--shell\"><i class=\"cos-i-4\" id=\"pillarBar\" data-scrub-probe=\"pillarBar\"></i></div></div><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* CHAPTER 03 \u2014 THE STANDARD (pinned, scrubbed pillars). */\nWZ.add(function (W) {\n  var pin = document.getElementById('pillarsPin');\n  var pillars = gsap.utils.toArray('[data-pillar]');\n  var bar = document.getElementById('pillarBar');\n  if (!pin || !pillars.length) return;\n\n  var paint = function (p) {\n    if (bar) gsap.set(bar, { scaleX: p });\n    pillars.forEach(function (pl, i) {\n      pl.classList.toggle('is-active', p >= i / pillars.length + 0.03);\n    });\n  };\n\n  var mm = gsap.matchMedia();\n  mm.add('(min-width: 760px)', function () {\n    return W.scrub(\n      { trigger: pin, start: 'top top', end: '+=140%', pin: true, scrub: 0.3, anticipatePin: 1, invalidateOnRefresh: true },\n      paint\n    );\n  });\n  mm.add('(max-width: 759px)', function () {\n    return W.scrub({ trigger: pin, start: 'top 80%', end: 'bottom 55%', scrub: 0.35 }, paint);\n  });\n});\n/* A dimmed pillar list would read as a page that failed to load. */\nWZ.staticPaint(function () {\n  document.querySelectorAll('[data-pillar]').forEach(function (p) { p.classList.add('is-active'); });\n});\n</script></section><section class=\"cos-section-3 ch ch--pin ch-proof\" id=\"proof\" data-chapter=\"4\" data-chapter-name=\"The Proof\" data-theme=\"dark\"><div class=\"gm-box ch__pin proof__pin\" id=\"proofPin\"><div class=\"gm-box proof__head shell\"><p class=\"cos-p chapter-tag\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">04</b><em class=\"cos-em-4\">The Proof</em></p><h2 class=\"cos-h2-5\" data-split=\"\">Real smiles from Grand Mission Dentistry patients</h2><p class=\"cos-p lede\">Before and after, actual patients. Tap any case to see it full size.</p></div><div class=\"proof__rail\" id=\"ribbonRail\" data-scrub-probe=\"ribbonRail\"><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f76fc490cc1bb6fbffb5_case-1.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 01</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case one\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f76fc490cc1bb6fbffb5_case-1.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c0f4fd87d5da086c71_case-2.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 02</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case two\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c0f4fd87d5da086c71_case-2.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c2cb3ef410cc1f29ef_case-3.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 03</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case three\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c2cb3ef410cc1f29ef_case-3.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c2dc6b88df76abe9d9_case-4.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 04</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case four\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c2dc6b88df76abe9d9_case-4.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c337e95e870ef06a9b_case-5.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 05</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case five\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c337e95e870ef06a9b_case-5.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c3cb3ef410cc1f2b0c_case-6.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 06</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case six\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c3cb3ef410cc1f2b0c_case-6.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c41dadf496bffd951b_case-7.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 07</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case seven\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c41dadf496bffd951b_case-7.jpeg\"/></button><button class=\"case cos-emb-6 case\" data-lightbox=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c4588840291f756dc4_case-8.jpeg\"><span class=\"gallery__badge cos-emb-5\">Case 08</span><img class=\"cos-emb-4\" alt=\"Before and after cosmetic treatment, case eight\" src=\"https://cdn.prod.website-files.com/698111847e9608eb30ee21c6/6a75f7c4588840291f756dc4_case-8.jpeg\"/></button></div><div class=\"gm-box proof__foot shell\"><div class=\"gm-box ch__rail\"><i class=\"cos-i-5\" id=\"ribbonBar\"></i></div><p class=\"cos-disclaimer\"> Results vary from patient to patient. These are individual outcomes and depend on oral health, lifestyle and the specifics of treatment. Yours will be discussed at your consultation. </p></div></div><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* CHAPTER 04 \u2014 THE PROOF (pinned horizontal ribbon): eight real cases\n   travel sideways. */\nWZ.add(function (W) {\n  var pin = document.getElementById('proofPin');\n  var rail = document.getElementById('ribbonRail');\n  var bar = document.getElementById('ribbonBar');\n  if (!pin || !rail) return;\n\n  function distance() {\n    return Math.max(0, rail.scrollWidth - window.innerWidth + 40);\n  }\n\n  var mm = gsap.matchMedia();\n  mm.add('(min-width: 901px)', function () {\n    var cases = gsap.utils.toArray('.case');\n    gsap.to(rail, {\n      x: function () { return -distance(); },\n      ease: 'none',\n      scrollTrigger: {\n        trigger: pin,\n        start: 'top top',\n        end: function () { return '+=' + (distance() + window.innerHeight * 0.6); },\n        pin: true,\n        scrub: 0.3,\n        anticipatePin: 1,\n        invalidateOnRefresh: true,\n        onUpdate: function (self) {\n          gsap.set(bar, { scaleX: self.progress });\n          /* Whichever case is nearest the middle is the one being looked\n             at, so it is the one that comes up to full colour. */\n          var mid = window.innerWidth / 2;\n          var best = 0,\n            bestD = Infinity;\n          cases.forEach(function (c, i) {\n            var r = c.getBoundingClientRect();\n            var d = Math.abs(r.left + r.width / 2 - mid);\n            if (d < bestD) { bestD = d; best = i; }\n          });\n          cases.forEach(function (c, i) { c.classList.toggle('is-centre', i === best); });\n        },\n      },\n    });\n    /* No kill here \u2014 matchMedia already owns this tween and its pin;\n       reverting it twice strips the pin spacer out of the layout. */\n    return function () { gsap.set(bar, { scaleX: 1 }); };\n  });\n\n  mm.add('(max-width: 900px)', function () {\n    var onScroll = function () {\n      var max = rail.scrollWidth - rail.clientWidth;\n      gsap.set(bar, { scaleX: max > 0 ? rail.scrollLeft / max : 1 });\n    };\n    onScroll();\n    rail.addEventListener('scroll', onScroll, { passive: true });\n    return function () { rail.removeEventListener('scroll', onScroll); };\n  });\n});\n</script></section><section class=\"cos-section ch ch-voices\" id=\"voices\" data-recede=\"\" data-chapter=\"5\" data-chapter-name=\"The Voices\" data-theme=\"paper\"><div class=\"gm-box shell\"><div class=\"gm-box cos-head head--center\" data-rv=\"\"><p class=\"cos-p chapter-tag chapter-tag--center\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">05</b><em class=\"cos-em-3\">The Voices</em></p><h2 class=\"cos-h2-2\" data-split=\"\">Rated highly by the Richmond, TX community</h2><p class=\"cos-p lede\">Here's what our happy patients say.</p></div><div class=\"badges\" data-rv=\"stagger\"><span class=\"badge\"><span class=\"gm-stars\" aria-hidden=\"true\">\u2605\u2605\u2605\u2605\u2605</span> <strong class=\"cos-strong-4\">1,700+</strong> Google reviews</span> <span class=\"badge\"><strong class=\"cos-strong-4\">Nextdoor</strong> Neighborhood Favorite 2021\u20132024</span> <span class=\"badge\"><strong class=\"cos-strong-4\">Healthgrades</strong> 2023 Patient Safety Award</span> <span class=\"badge\"><span class=\"gm-stars\" aria-hidden=\"true\">\u2605\u2605\u2605\u2605\u2605</span> <strong class=\"cos-strong-4\">Yelp</strong> five-star business</span></div><div class=\"gm-box gm-grid c3\" data-rv=\"stagger\"><figure class=\"quote\"><span class=\"gm-stars\" aria-label=\"Five out of five stars\">\u2605\u2605\u2605\u2605\u2605</span><p class=\"cos-p-8\">\u201cThis is the best dental place I've been to since I moved to Texas. Customer service is superb, so kind, friendly, and welcoming.\u201d</p><figcaption class=\"cos-figcaption\">Diane C.<span class=\"cos-span-3\">Google review</span></figcaption></figure><figure class=\"quote\"><span class=\"gm-stars\" aria-label=\"Five out of five stars\">\u2605\u2605\u2605\u2605\u2605</span><p class=\"cos-p-8\">\u201cDr. Van and Hygienist Karen were amazing today! I've got my plan to start a healthier mouth and I'm so excited!\u201d</p><figcaption class=\"cos-figcaption\">Cedaro<span class=\"cos-span-3\">Google review</span></figcaption></figure><figure class=\"quote\"><span class=\"gm-stars\" aria-label=\"Five out of five stars\">\u2605\u2605\u2605\u2605\u2605</span><p class=\"cos-p-8\">\u201cBest experience! Very up to date with equipment and the cleanest dental office I've ever been to.\u201d</p><figcaption class=\"cos-figcaption\">Tiffany T.<span class=\"cos-span-3\">Google review</span></figcaption></figure></div></div></section><section class=\"cos-section-3 ch ch-invitation\" id=\"invitation\" data-chapter=\"6\" data-chapter-name=\"The Invitation\" data-theme=\"dark\"><div class=\"invitation__glow\" aria-hidden=\"true\"></div><div class=\"gm-box shell cos-closing\"><p class=\"cos-p-9 chapter-tag chapter-tag--center\" data-rv=\"\"><i class=\"cos-i-2\"></i><b class=\"cos-b-2\">06</b><em class=\"cos-em-4\">The Invitation</em></p><h2 class=\"cos-h2-5\" data-split=\"\">Ready for a confident, radiant smile?</h2><p class=\"cos-p lede\" data-rv=\"\"> Take the first step toward your dream smile. Schedule your consultation at Grand Mission Dentistry in Richmond, TX, and experience advanced cosmetic care with a personal touch. </p><div class=\"closing__actions\" data-rv=\"stagger\"><a class=\"cos-a-2 btn btn--light btn--lg magnetic\" href=\"#book\"><span class=\"btn-before-2\"></span><span class=\"cos-span-2\">Book your free consultation</span></a> <a class=\"cos-a-4 btn btn--ghost btn--lg magnetic\" href=\"#\" data-tel-link=\"\"><span class=\"btn-before-3\"></span><span class=\"cos-span-2\">Call <span class=\"gm-box\" data-tel=\"\">(281) 729-4615</span></span></a></div></div><script class=\"wz-js cos-emb-3 wz-js\" data-embed=\"\">\n/* CHAPTER 06 \u2014 THE INVITATION: the glow breathes with scroll. */\nWZ.add(function (W) {\n  gsap.fromTo(\n    '.invitation__glow',\n    { scale: 0.82, opacity: 0.45 },\n    {\n      scale: 1.18,\n      opacity: 1,\n      ease: 'none',\n      scrollTrigger: { trigger: '#invitation', start: 'top bottom', end: 'bottom bottom', scrub: 0.7 },\n    }\n  );\n});\n</script></section></ma