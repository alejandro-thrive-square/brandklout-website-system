  "code": "<style>*{box-sizing:border-box}*::before{box-sizing:border-box}*::after{box-sizing:border-box}p{margin:0}button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}.btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:0.65rem;padding:1.05rem 2rem;border:2px solid transparent;border-radius:48px;font-size:11.68px;letter-spacing:0.14em;text-transform:uppercase;font-weight:700;overflow:hidden;isolation:isolate;background:#04669c;color:#fff;transition:color 0.45s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.45s cubic-bezier(0.22, 1, 0.36, 1),\n    box-shadow 0.45s cubic-bezier(0.22, 1, 0.36, 1);box-shadow:0 10px 26px rgba(4, 102, 156, 0.26);will-change:transform}.btn > span{position:relative;z-index:2}.btn::before{content:\"\";position:absolute;inset:0;z-index:1;background:#002241;transform:translateY(101%);transition:transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)}.btn:hover::before{transform:translateY(0)}.btn:hover{box-shadow:0 16px 36px rgba(0, 34, 65, 0.3)}.btn--wide{width:100%}.panel__body{padding:1.5rem 1.6rem 1.6rem}.field{display:grid;gap:0.35rem;margin-bottom:0.75rem}.field label{font-size:12.47px;font-weight:700;color:#444}.field input{width:100%;padding:0.85rem 1rem;border:2px solid #e7ecf1;border-radius:8px;font:inherit;font-size:15.26px;background:#f7f9fb;transition:border-color 0.3s cubic-bezier(0.22, 1, 0.36, 1), background 0.3s cubic-bezier(0.22, 1, 0.36, 1)}.field input:focus{border-color:#04669c;background:#fff;outline:none}.field__error{font-size:12.21px;color:#c0392b;font-weight:600}.options{display:grid;gap:0.55rem}.option{position:relative;display:block}.option input{position:absolute;opacity:0;width:0;height:0}.option span{display:flex;align-items:center;gap:0.8rem;padding:0.9rem 1.1rem;border:2px solid #e7ecf1;border-radius:8px;font-weight:600;font-size:14.99px;transition:border-color 0.25s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s cubic-bezier(0.22, 1, 0.36, 1),\n    transform 0.25s cubic-bezier(0.22, 1, 0.36, 1)}.option span::before{content:\"\";flex:none;width:18px;height:18px;border-radius:50%;border:2px solid #ccc;transition:border-color 0.25s, box-shadow 0.25s}.option span:hover{border-color:#abd6ff;transform:translateX(3px)}.consent{display:flex;gap:0.7rem;align-items:flex-start;font-size:11.81px;color:#666;line-height:1.5;margin:0.9rem 0 1rem;font-weight:400}.consent input{margin-top:3px;width:18px;height:18px;flex:none;accent-color:#04669c}.honeypot{position:absolute;left:-9999px;width:0;height:0;opacity:0}.panel__foot{font-size:11.81px;color:#666;text-align:center;margin-top:0.9rem;font-weight:400}.gm-step{display:none;border:0;margin:0;padding:0}.step__q{font-size:16.85px;font-weight:700;color:#002241;margin:0 0 0.9rem;padding:0;line-height:1.35;letter-spacing:-0.02em}.panel__nav{display:flex;align-items:center;gap:0.8rem;margin-top:0.9rem}.panel__back{font-size:13.67px;font-weight:600;color:#666;padding:0.5rem 0.25rem;transition:color 0.3s}.panel__back:hover{color:#04669c}@media (min-width: 1920px){.btn{font-size:13.13px}.field label{font-size:14.03px}.field input{font-size:17.16px}.field__error{font-size:13.73px}.option span{font-size:16.87px}.consent{font-size:13.28px}.panel__foot{font-size:13.28px}.step__q{font-size:18.96px}.panel__back{font-size:15.37px}}@media (max-width: 991px){.btn{font-size:14.08px}.field label{font-size:15.04px}.field input{font-size:18.4px}.field__error{font-size:14.72px}.option span{font-size:18.08px}.consent{font-size:14.24px}.panel__foot{font-size:14.24px}.step__q{font-size:20.32px}.panel__back{font-size:16.48px}}@media (max-width: 767px){.btn{font-size:14.08px}.field label{font-size:15.04px}.field input{font-size:18.4px}.field__error{font-size:14.72px}.option span{font-size:18.08px}.consent{font-size:14.24px}.panel__foot{font-size:14.24px}.step__q{font-size:20.32px}.panel__back{font-size:16.48px}}@media (max-width: 479px){.btn{font-size:12.33px}.field label{font-size:13.17px}.field input{font-size:16.11px}.field__error{font-size:12.89px}.option span{font-size:15.83px}.consent{font-size:12.47px}.panel__foot{font-size:12.47px}.step__q{font-size:17.8px}.panel__back{font-size:14.43px}}</style><form class=\"panel__body\" id=\"leadForm\" novalidate=\"\">\n<fieldset class=\"gm-step is-active\" data-step=\"1\">\n<legend class=\"step__q\">How many teeth are you missing?</legend>\n<div class=\"options\">\n<label class=\"option\"><input name=\"missing_teeth\" type=\"radio\" value=\"1\"/><span>Just one</span></label>\n<label class=\"option\"><input name=\"missing_teeth\" type=\"radio\" value=\"2-3\"/><span>Two or three</span></label>\n<label class=\"option\"><input name=\"missing_teeth\" type=\"radio\" value=\"4+\"/><span>Four or more</span></label>\n<label class=\"option\"><input name=\"missing_teeth\" type=\"radio\" value=\"failing\"/><span>None yet \u2014 a tooth or an old implant is failing</span></label>\n</div>\n</fieldset>\n<fieldset class=\"gm-step\" data-step=\"2\">\n<legend class=\"step__q\">How long has the tooth been gone?</legend>\n<div class=\"options\">\n<label class=\"option\"><input name=\"time_since_loss\" type=\"radio\" value=\"under-6-months\"/><span>Less than 6 months</span></label>\n<label class=\"option\"><input name=\"time_since_loss\" type=\"radio\" value=\"6-24-months\"/><span>6 months to 2 years</span></label>\n<label class=\"option\"><input name=\"time_since_loss\" type=\"radio\" value=\"2-years-plus\"/><span>More than 2 years</span></label>\n<label class=\"option\"><input name=\"time_since_loss\" type=\"radio\" value=\"not-sure\"/><span>I'm not sure</span></label>\n</div>\n</fieldset>\n<fieldset class=\"gm-step\" data-step=\"3\">\n<legend class=\"step__q\">When would you like to get this handled?</legend>\n<div class=\"options\">\n<label class=\"option\"><input name=\"timeline\" type=\"radio\" value=\"asap\"/><span>As soon as possible</span></label>\n<label class=\"option\"><input name=\"timeline\" type=\"radio\" value=\"3-months\"/><span>Within the next three months</span></label>\n<label class=\"option\"><input name=\"timeline\" type=\"radio\" value=\"researching\"/><span>Still researching my options</span></label>\n</div>\n</fieldset>\n<fieldset class=\"gm-step\" data-step=\"4\">\n<legend class=\"step__q\">How would you like to handle the cost?</legend>\n<div class=\"options\">\n<label class=\"option\"><input name=\"payment_preference\" type=\"radio\" value=\"ppo-insurance\"/><span>I have PPO dental insurance</span></label>\n<label class=\"option\"><input name=\"payment_preference\" type=\"radio\" value=\"financing\"/><span>I'd like to hear about monthly financing</span></label>\n<label class=\"option\"><input name=\"payment_preference\" type=\"radio\" value=\"hsa-fsa\"/><span>HSA or FSA</span></label>\n<label class=\"option\"><input name=\"payment_preference\" type=\"radio\" value=\"out-of-pocket\"/><span>Paying out of pocket</span></label>\n</div>\n</fieldset>\n<fieldset class=\"gm-step\" data-step=\"5\">\n<legend class=\"step__q\">Where should Dr. Sung's team send your consultation details?</legend>\n<div class=\"field\">\n<label for=\"f-name\">Full name</label>\n<input autocomplete=\"name\" id=\"f-name\" name=\"full_name\" required=\"\" type=\"text\"/>\n<p class=\"field__error\" data-error-for=\"f-name\"></p>\n</div>\n<div class=\"field\">\n<label for=\"f-email\">Email</label>\n<input autocomplete=\"email\" id=\"f-email\" name=\"email\" required=\"\" type=\"email\"/>\n<p class=\"field__error\" data-error-for=\"f-email\"></p>\n</div>\n<div class=\"field\">\n<label for=\"f-phone\">Phone</label>\n<input autocomplete=\"tel\" id=\"f-phone\" name=\"phone\" required=\"\" type=\"tel\"/>\n<p class=\"field__error\" data-error-for=\"f-phone\"></p>\n</div>\n<!-- spam trap: real people never see this -->\n<div aria-hidden=\"true\" class=\"honeypot\">\n<label for=\"f-website\">Company website</label>\n<input autocomplete=\"off\" id=\"f-website\" name=\"company_website\" tabindex=\"-1\" type=\"text\"/>\n</div>\n<label class=\"consent\">\n<input id=\"f-consent\" name=\"consent\" required=\"\" type=\"checkbox\"/>\n<span>\n                      I agree to the terms and conditions provided by Grand Mission Dentistry. By\n                      providing my phone number I agree to receive text messages from the practice.\n                      Message and data rates may apply.\n                    </span>\n</label>\n<p class=\"field__error\" data-error-for=\"f-consent\"></p>\n</fieldset>\n<div class=\"panel__nav\">\n<button class=\"panel__back\" hidden=\"\" id=\"quizBack\" type=\"button\">\u2190 Back</button>\n<button class=\"btn btn--wide magnetic\" id=\"quizNext\" type=\"submit\"><span>Continue</span></button>\n</div>\n<p class=\"panel__foot\">Free \u00b7 No pressure \u00b7 A real conversation about your options</p>\n</form>",
