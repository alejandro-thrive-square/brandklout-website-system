let dimReviews = { 
    address: "",
    fullStar: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" style=" fill: #fbbc04; width:16px"><path d="M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z"/></svg>`,
    halfStar: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" style=" fill: #fbbc04; width:16px "><path d="M288 376.4l.1-.1 26.4 14.1 85.2 45.5-16.5-97.6-4.8-28.7 20.7-20.5 70.1-69.3-96.1-14.2-29.3-4.3-12.9-26.6L288.1 86.9l-.1 .3V376.4zm175.1 98.3c2 12-3 24.2-12.9 31.3s-23 8-33.8 2.3L288.1 439.8 159.8 508.3C149 514 135.9 513.1 126 506s-14.9-19.3-12.9-31.3L137.8 329 33.6 225.9c-8.6-8.5-11.7-21.2-7.9-32.7s13.7-19.9 25.7-21.7L195 150.3 259.4 18c5.4-11 16.5-18 28.8-18s23.4 7 28.8 18l64.3 132.3 143.6 21.2c12 1.8 22 10.2 25.7 21.7s.7 24.2-7.9 32.7L438.5 329l24.6 145.7z"/></svg>`,

    setStarRating : (rating, fullstar, halfstar) => {
        // Determine the number of full stars
        var fullStars = Math.floor(rating);
        
        // Determine if there's a half star
        var hasHalfStar = rating % 1 !== 0;
        
        // Create HTML content for full stars
        var fullStarsHtml = fullstar.repeat(fullStars);
        
        // Create HTML content for half star (if applicable)
        var halfStarHtml = hasHalfStar ? halfstar : '';
        if(rating >= 4.5 ){
            halfStarHtml = fullstar;
        }

        if(rating >= 5) halfStarHtml = "";
        
        // Set the HTML content of .star-rating element
        var starRatingElement = document.querySelector('.star-rating');
        if (starRatingElement) {
            var starRatingHtml = '<div style="display:inline-flex; gap:5px; width:120px; justify-content:center; align-items:center; margin:0px 5px">' + fullStarsHtml + halfStarHtml + '</div>';
            starRatingElement.innerHTML = starRatingHtml;
        }
    },

    update: (address) => {
        // Make a GET request using fetch API
        if(dimReviews.address==""){
        
            dimReviews.address = address;
            console.log("addrses",address)

            setTimeout( () => {
                var address = encodeURIComponent(dimReviews.address);
                console.log("addressw",dimReviews.address)
                if (typeof address === 'undefined') {
                    }else{
                    
                    // Create a new XMLHttpRequest object
                    var xhr = new XMLHttpRequest();

                    // Configure the request
                    xhr.open('GET', `https://data.localdentalimplants.dentist/reviews/index.php?address=${address}`, true);

                    // Set up a callback function to handle the response
                    xhr.onload = function() {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            // Request was successful

                            if (xhr.responseText !== null) {
                                var response = JSON.parse(xhr.responseText);
                                var h3 = document.querySelector('.custom-code-container h3 strong');
                                h3.textContent = response.rating;

                                var atag = document.querySelector('.custom-code-container a p');
                                atag.textContent = response.reviews + " reviews ";

                                // Example usage:
                                var fullstar = dimReviews.fullStar;
                                var halfstar = dimReviews.halfStar;
                                dimReviews.setStarRating(response.rating, fullstar, halfstar);

                                // Get the element with the class 'reviewcount'
                                var reviewcountElement = document.querySelector('.reviewcount');

                                // Apply flexbox styles using JavaScript
                                reviewcountElement.style.display = 'flex';
                                reviewcountElement.style.alignItems = 'center';
                                reviewcountElement.style.justifyContent = 'center';

                                document.querySelector('.star-rating').style.display = 'flex';
                                document.querySelector('.star-rating').style.alignItems = 'center';
                                document.querySelector('.star-rating').style.justifyContent = 'center';
                            }

                        } 
                    };

                    // Send the request
                    xhr.send();

                }

            }, 300);

        }

    }
}

