  "stays": [
    "--font-from: 18   (redefined at a breakpoint: stays in the registry :root)",
    "--font-to: 20   (redefined at a breakpoint: stays in the registry :root)",
    "--vw-from: calc(1920 / 100)   (redefined at a breakpoint: stays in the registry :root)",
    "--vw-to: calc(2400 / 100)   (redefined at a breakpoint: stays in the registry :root)",
    "--wide: 1   (redefined at a breakpoint: stays in the registry :root)",
    "--t-display: 1   (redefined at a breakpoint: stays in the registry :root)",
    "--t-heading: 1   (redefined at a breakpoint: stays in the registry :root)",
    "--t-sub: 1   (redefined at a breakpoint: stays in the registry :root)",
    "--t-text: 1   (redefined at a breakpoint: stays in the registry :root)",
    "--size-h3-j: calc(1.85rem * var(--t-heading))   (redefined at a breakpoint: stays in the registry :root)",
    "--spec-w: 20rem   (redefined at a breakpoint: stays in the registry :root)",
    "--coefficient: calc((var(--font-to) - var(--font-from)) / (var(--vw-to) - var(--vw-from)))",
    "--base: calc((var(--font-from) - var(--vw-from) * var(--coefficient)) / 16)",
    "--scrim: linear-gradient(180deg, rgba(39, 39, 39, 0.42) 0%, rgba(39, 39, 39, 0.12) 38%, rgba(39, 39, 39, 0.72) 100%)",
    "--scrim-side: linear-gradient(100deg, rgba(39, 39, 39, 0.66) 0%, rgba(39, 39, 39, 0.34) 42%, rgba(39, 39, 39, 0) 72%)",
    "--font-display: \"Cormorant Garamond\", \"Cormorant\", Georgia, \"Times New Roman\", serif",
    "--font-body: \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
    "--size-h4: calc(1.625rem * var(--t-sub))   (the Framework writes 2-decimal rem; 1.63rem would shift it)",
    "--size-h6: calc(1.0625rem * var(--t-sub))   (the Framework writes 2-decimal rem; 1.06rem would shift it)",
    "--size-text-medium: calc(1.125rem * var(--t-text))   (the Framework writes 2-decimal rem; 1.13rem would shift it)",
    "--size-text-small: calc(0.875rem * var(--t-text))   (the Framework writes 2-decimal rem; 0.88rem would shift it)",
    "--space-tiny: 0.125rem   (the Framework writes 2-decimal rem; 0.13rem would shift it)",
    "--radius: 2px   (the Framework writes 2-decimal rem; 0.13rem would shift it)",
    "--shadow-card: 0 1px 2px rgba(39, 39, 39, 0.04), 0 8px 24px rgba(39, 39, 39, 0.06)",
    "--shadow-card-hover: 0 2px 4px rgba(39, 39, 39, 0.06), 0 18px 44px rgba(39, 39, 39, 0.1)",
    "--ease: cubic-bezier(0.22, 1, 0.36, 1)",
    "--gutter: max(clamp(1.25rem, 4vw, 4.5rem), calc((100vw - 97.5rem) / 2))",
    "--section: clamp(4rem, 7vw, 8.5rem)",
    "--section-sm: clamp(2.5rem, 4.5vw, 5rem)",
    "--pad-panel: clamp(1.75rem, 3.4vw, 4rem)",
    "--section: clamp(3.25rem, 5.5vw, 7rem)",
    "--section-sm: clamp(2.25rem, 3.6vw, 4.25rem)",
    "--pad-panel: clamp(2rem, 3.8vw, 4.5rem)",
    "--ease-settle: cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-cine: cubic-bezier(0.77, 0, 0.175, 1)"
