# Generated by to-instatic.mjs from ../home/. Regenerated in one command, and
# the page JSON is a copy of home/index.html's body. The run order it documents
# lives in the README.
instatic/

# The Instatic admin session cookies. Credentials, never committed.
.session
.session-*

# The converted node graphs produced by shipping instatic/pages into the
# container and running the converter there. Reproducible, and far past
# "lightweight artifact".
converted-pages.json

# playwright-core, installed by .tmp/package.json for shot.mjs. Already covered
# by the root .gitignore; named here so it is obvious why the folder exists.
node_modules/
package-lock.json

# shot.mjs output. PNGs are refused repo-wide by extension anyway.
shots/

# Instatic backups taken by backup-site.mjs. Multi-MB JSON dumps of a live
# instance; regenerable from the instance while it still exists, and far past
# "lightweight artifact". Keep them locally, do not commit them.
backup-*.json

# The local -> uploaded media map and its log. Environment specific (the ids
# are the staging instance's) and rewritten by every upload-media.mjs run.
instatic-media-map.json
media-upload-log.json
