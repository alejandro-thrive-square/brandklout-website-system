# Generated. `node build.mjs` reproduces it in seconds, and it carries ~14MB of
# the practice's photography - the repo rules forbid committing binary/media.
dist/

# Verification screenshots of the rebuild, and slices of the pre-takedown
# captures. Both are regenerated on demand by shot.mjs / slice.mjs.
shots/
slices/

# Generated by to-instatic.mjs from dist/. Regenerated in one command, and the
# page JSON duplicates dist/ HTML. IMPORT.md's content lives in the README.
instatic/
weight-report.json

# The converted node graphs, ~15MB, produced by shipping instatic/pages into the
# container and running container-convert.ts there. Reproducible in two commands
# (ship-payload.mjs then fetch-nodes.mjs) and far past "lightweight artifact".
converted-pages.json
