  "notes": {
    "ch": "the chapter shell on every <section> (ground, theme scope, vertical rhythm); ch-<name> is the section identity -> section_<name>",
    "wrap": "the chapter content width wrapper (.ch .wrap); container-large already exists on this site with other values",
    "chapter-tag": "the numbered label + animated rule above every chapter heading; a component with child elements (i, b) and a script hook, not a pure type utility, so chapter_tag rather than text-style-tagline",
    "cp-kicker": "small caps label above headings on the core pages: the tagline role",
    "has-dropdown": "navbar_item variant with a submenu: combo",
    "has-journey": "body of a page built as chapters: combo on the page body",
    "is-a": "mosaic tile positions a, b, c, e, f, g -> ordinals",
    "svc-card": "the generic card of the journey layer (policy pages, services, resources); service-card_* already exists from the earlier design system, so content-card",
