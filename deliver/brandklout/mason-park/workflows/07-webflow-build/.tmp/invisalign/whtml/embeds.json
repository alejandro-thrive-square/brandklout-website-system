  "code": "<style>*{box-sizing:border-box}*::before{box-sizing:border-box}*::after{box-sizing:border-box}svg{max-width:100%;height:auto;display:block}p{margin:0}button{font:inherit;color:inherit}input{font:inherit;color:inherit}button{background:none;border:0;cursor:pointer}.btn{display:inline-flex;align-items:center;justify-content:center;gap:0.55rem;padding:0.95rem 1.6rem;border-radius:999px;font-family:\"Outfit\", \"Segoe UI\", system-ui, sans-serif;font-size:0.9375rem;font-weight:600;letter-spacing:0.01em;line-height:1;position:relative;overflow:hidden;isolation:isolate;border:1px solid transparent;background:#1b2224;color:#ffffff;min-height:44px;transition:transform 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.4s cubic-bezier(0.22, 0.61, 0.36, 1), color 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);will-change:transform}.btn::before{content:\"\";position:absolute;inset:0;z-index:1;background:radial-gradient(140px circle at 50% 50%,\n              rgba(255, 255, 255, 0.22), transparent 62%);opacity:0;transition:opacity 0.4s cubic-bezier(0.22, 0.61, 0.36, 1)}.btn:hover::before{opacity:1}.btn:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(27, 34, 36, 0.05), 0 22px 48px -20px rgba(27, 34, 36, 0.26)}.btn:active{transform:translateY(0)}.btn--sand{background:#a8875f;color:#ffffff}.btn--ghost{background:transparent;border-color:#dfe4e6;color:#1b2224}.btn--ghost:hover{border-color:#a8875f}.btn--lg{padding:1.1rem 2rem;font-size:1rem}.btn--block{width:100%}.progress{display:flex;gap:0.35rem;margin-bottom:1.25rem}.progress span{flex:1;height:3px;border-radius:999px;background:#dfe4e6;transition:background 0.4s cubic-bezier(0.22, 0.61, 0.36, 1)}.progress span.on{background:#a8875f}.step-panel{display:none}.step-panel.active{display:block}.choices{display:grid;gap:0.5rem}.choice{display:flex;align-items:center;gap:0.7rem;width:100%;text-align:left;padding:0.85rem 1rem;border:1px solid #dfe4e6;border-radius:0.875rem;background:#ffffff;font-size:0.9375rem;min-hei