l3.8 3a6.9 6.9 0 0 1 6.4-4.7z\" fill=\"#EA4335\"></path></svg></figcaption></figure></div><div class=\"accred\"><p class=\"inv-p-12 label\">Continuing education and accreditation</p><div class=\"accred-row\" id=\"accredRow\"><img class=\"inv-img-5\" src=\"https://cdn.prod.website-files.com/6a60bdc0340e5f1784b4d553/6a75f6f4801acb199feea0b6_badge-kois.webp\" alt=\"Kois Center\" width=\"auto\" height=\"auto\" loading=\"lazy\"><img class=\"inv-img-5\" src=\"https://cdn.prod.website-files.com/6a60bdc0340e5f1784b4d553/6a75f6f423da04c51f1ebf0c_badge-ssc.webp\" alt=\"Seattle Study Club\" width=\"auto\" height=\"auto\" loading=\"lazy\"><img class=\"inv-img-5\" src=\"https://cdn.prod.website-files.com/6a60bdc0340e5f1784b4d553/6a75f6f4cb4cbbb84091e7ba_badge-agd.webp\" alt=\"Academy of General Dentistry\" width=\"auto\" height=\"auto\" loading=\"lazy\"><img class=\"inv-img-5\" src=\"https://cdn.prod.website-files.com/6a60bdc0340e5f1784b4d553/6a75f6f323da04c51f1ebea5_badge-aapd.webp\" alt=\"American Academy of Pediatric Dentistry\" width=\"auto\" height=\"auto\" loading=\"lazy\"><img class=\"inv-img-5\" src=\"https://cdn.prod.website-files.com/6a60bdc0340e5f1784b4d553/6a75f6f39d16ef209fb2de54_badge-abpd.webp\" alt=\"American Board of Pediatric Dentistry\" width=\"auto\" height=\"auto\" loading=\"lazy\"></div></div></div></section>",
