  "html": "<section class=\"inv-section-2 chapter ch-proof\" id=\"proof\" data-chapter=\"5\" data-chapter-name=\"The Proof\" data-theme=\"dark\"><div class=\"mpd-box wrap chapter-body\"><div class=\"mpd-box proof-head head-block head-block--center\"><p class=\"inv-p-11 chapter-tag\"><i class=\"inv-i-2\"></i><span class=\"mpd-box\">Chapter 05 \u00b7 The Proof</span></p><h2 class=\"inv-h2-2\">What our patients say afterwards.</h2><div class=\"proof-score\"><span class=\"stars\" aria-hidden=\"true\"><svg class=\"inv-emb-1 inv-svg\" fill=\"currentColor\" height=\"18\" viewbox=\"0 0 20 20\" width=\"18\"><path d=\"M10 1l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.4 4.7 17.1l1-5.8L1.5 7.2l5.9-.9z\"></path></svg><svg class=\"inv-emb-1 inv-svg\" fill=\"currentColor\" height=\"18\" viewbox=\"0 0 20 20\" width=\"18\"><path d=\"M10 1l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.4 4.7 17.1l1-5.8L1.5 7.2l5.9-.9z\"></path></svg><svg class=\"inv-emb-1 inv-svg\" fill=\"currentColor\" height=\"18\" viewbox=\"0 0 20 20\" width=\"18\"><path d=\"M10 1l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.4 4.7 17.1l1-5.8L1.5 7.2l5.9-.9z\"></path></svg><svg class=\"inv-emb-1 inv-svg\" fill=\"currentColor\" height=\"18\" viewbox=\"0 0 20 20\" width=\"18\"><path d=\"M10 1l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.4 4.7 17.1l1-5.8L1.5 7.2l5.9-.9z\"></path></svg><svg class=\"inv-emb-1 inv-svg\" fill=\"currentColor\" height=\"18\" viewbox=\"0 0 20 20\" width=\"18\"><path d=\"M10 1l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.4 4.7 17.1l1-5.8L1.5 7.2l5.9-.9z\"></path></svg></span> <b class=\"inv-b-3\" id=\"proofScore\">5.0</b> <span class=\"inv-span-8 small\">rated by our patients on Google</span></div></div><div class=\"inv-div-10 grid grid--3\" id=\"proofGrid\"><figure class=\"review\"><span class=\"stars\" aria-label=\"5 out of 5 stars\"><svg class=\"inv-emb-1 inv-svg\" aria-hidden=\"true\" fill=\"currentColor\" height=\"15\" viewbox=\"0 0 20 20\" width=\"15\"><path d=\"M10 1l2.6 5.3 5.9.9-4.2 4.1 1 5.8L10 14.4 4.7 17.1l1-5.8L1.5 7.2l5.9-.9z\"></pat