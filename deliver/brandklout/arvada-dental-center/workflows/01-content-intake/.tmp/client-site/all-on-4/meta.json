    "{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"How Much Do All-On-4 Dental Implants Cost In Arvada, CO?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"The cost varies based on materials and patient needs. All-on-4 dental implants are more cost-effective than traditional implants. A consultation helps determine exact pricing.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"Who Is A Good Candidate For All-On-4 Dental Implants In Arvada, CO?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Ideal candidates have multiple missing teeth or wear dentures. Patients with low bone density may also qualify. A dental exam confirms eligibility.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"What Materials Are Used In All-On-4 Dental Implants In Arvada, CO?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"High-quality materials like acrylic or zirconia are used. These ensure durability and aesthetics. Your dentist will recommend the right option.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"How Long Does The All-On-4 Procedure Take In Arvada, CO?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"The surgery usually takes about 2–3 hours per arch. Temporary teeth are often placed the same day. Healing continues over several months.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"What Are The Office Hours For All-On-4 Dental Implants In Arvada, CO?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Our Arvada dental offices operate Monday to Friday. Typical hours are 8:30 AM to 5:00 PM, with shorter Fridays. It’s ideal to confirm hours before booking.\"\n    }\n  }]\n}"
