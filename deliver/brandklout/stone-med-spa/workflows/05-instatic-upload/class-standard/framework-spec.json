    "--t-display: 1",
    "--t-heading: 1",
    "--t-sub: 1",
    "--t-text: 1",
    "--size-h4: calc(1.625rem * var(--t-sub))   (the Framework writes 2-decimal rem; 1.63rem would shift it)",
    "--size-h6: calc(1.0625rem * var(--t-sub))   (the Framework writes 2-decimal rem; 1.06rem would shift it)",
    "--size-text-medium: calc(1.125rem * var(--t-text))   (the Framework writes 2-decimal rem; 1.13rem would shift it)",
    "--size-text-small: calc(0.875rem * var(--t-text))   (the Framework writes 2-decimal rem; 0.88rem would shift it)",
    "--space-tiny: 0.125rem   (the Framework writes 2-decimal rem; 0.13rem would shift it)",
    "--radius: 999px   (the Framework writes 2-decimal rem; 62.44rem would shift it)",
    "--shadow-card: 0 1px 2px rgba(39, 39, 39, 0.04), 0 8px 24px rgba(39, 39, 39, 0.06)",
    "--shadow-card-hover: 0 2px 4px rgba(39, 39, 39, 0.06), 0 18px 44px rgba(39, 39, 39, 0.1)",
    "--ease: cubic-bezier(0.22, 1, 0.36, 1)"
