* text=auto
*.sh text eol=lf
# Git hooks are extensionless, so `* text=auto` would check them out CRLF. Git
# Bash tolerates a CRLF shebang; Ubuntu (the VPS) does not — it fails with
# "bad interpreter: /usr/bin/env bash^M".
scripts/hooks/** text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
