# Runs the worker every 2 minutes. Persistent=true catches up after downtime.
# Tune the interval by editing OnUnitActiveSec. Docs: .agents/DISPATCH.md
[Unit]
Description=Run the Webzite agent dispatch worker periodically

[Timer]
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=10s
Persistent=true
Unit=agent-dispatch-worker.service

[Install]
WantedBy=timers.target
