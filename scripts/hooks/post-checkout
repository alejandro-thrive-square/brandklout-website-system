#!/usr/bin/env bash
# Webzite post-checkout hook — seed a NEW worktree with the heavy assets that
# git refuses to carry.
#
# `git worktree add` checks out tracked files only, so a fresh worktree lands
# with the markup but none of the images it references: designs open broken.
# This is the mirror of the post-commit hook, running the other direction.
#
# Fires on `git worktree add`, `git clone`, and every `git checkout`. Args:
#   $1 previous HEAD   $2 new HEAD   $3 1 = branch checkout, 0 = file checkout
# On a brand-new worktree or clone, $1 is the null SHA. That is the only case we
# act on — reseeding on every ordinary branch switch would be slow and pointless.
#
# Never fails a checkout: a missing asset is not worth destroying a worktree.

set -uo pipefail

PREV="${1:-}"
IS_BRANCH="${3:-0}"
NULL_SHA="0000000000000000000000000000000000000000"

[[ "$IS_BRANCH" == "1" ]] || exit 0
[[ "$PREV" == "$NULL_SHA" ]] || exit 0
[[ -n "${WEBZITE_SKIP_ASSET_MIRROR:-}" ]] && exit 0

HERE="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
MAIN="$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0,10); exit}')"
[[ -n "$MAIN" && -d "$MAIN" ]] || exit 0

# The main worktree seeds others; it is never seeded itself.
[[ "$(cd "$HERE" && pwd -P)" == "$(cd "$MAIN" && pwd -P)" ]] && exit 0

SCRIPT="$MAIN/scripts/mirror-assets.sh"
[[ -f "$SCRIPT" ]] || exit 0

BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"

# Seeding every ignored asset would mean ~771 MB per worktree, most of it site
# scrapes and reference libraries the branch will never touch. Client folders are
# tens of MB, so derive the client from the branch name instead: strip the `bk-`
# prefix and prefix-match a directory under deliver/<pillar>/. Every current
# branch resolves this way (bk-stone -> stone-dental-implant-center).
# Match on progressively shorter prefixes. Orca branch names carry suffixes
# (bk-mason-park-2, bk-mason-park-fix), and a full-slug match alone would miss
# them: "mason-park-fix" is not a prefix of the folder "mason-park". Longest
# first, so bk-grand-mission cannot be stolen by a shorter sibling.
# Orca prefixes the branches it creates with the git username
# (alejandro-thrive-square/bk-livewell), so match on the last path segment, and
# fall back to the worktree directory name, which is what was typed in Orca.
SCOPES=()
for SEED in "$(basename "$HERE")" "${BRANCH##*/}"; do
  CANDIDATE="${SEED#bk-}"
  while [[ -n "$CANDIDATE" && ${#SCOPES[@]} -eq 0 ]]; do
    while IFS= read -r d; do
      SCOPES+=("${d%/}")
    # The new HEAD's own tree: main tracks no client folders since 2026-10-03.
    done < <(git ls-tree -d --name-only HEAD deliver/brandklout/ 2>/dev/null | grep "^deliver/brandklout/$CANDIDATE" | sed 's|$|/|')
    [[ ${#SCOPES[@]} -gt 0 ]] && break
    # Drop the last -segment; stop once nothing is left to trim.
    [[ "$CANDIDATE" == *-* ]] || break
    CANDIDATE="${CANDIDATE%-*}"
  done
  [[ ${#SCOPES[@]} -gt 0 ]] && break
done

if [[ ${#SCOPES[@]} -eq 0 ]]; then
  echo "post-checkout: new worktree '$BRANCH' — could not infer a client folder from the branch name."
  echo "  Heavy assets were NOT seeded; designs here will render with broken images."
  echo "  Seed them with:  bash \"$SCRIPT\" --to-worktree --scope <path>"
  echo "  Or everything (slow, ~771 MB):  bash \"$SCRIPT\" --to-worktree --all"
  exit 0
fi

echo "post-checkout: seeding heavy assets for '$BRANCH' from main..."
ARGS=(--to-worktree)
for s in "${SCOPES[@]}"; do
  echo "  scope: $s"
  ARGS+=(--scope "$s")
done
bash "$SCRIPT" "${ARGS[@]}" || echo "post-checkout: seeding failed — run it by hand (see above)."

exit 0
